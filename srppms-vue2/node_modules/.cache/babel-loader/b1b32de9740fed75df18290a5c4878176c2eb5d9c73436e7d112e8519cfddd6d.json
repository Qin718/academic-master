{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nexport default {\n  name: \"AsideItem\",\n  props: [\"menu\"],\n  methods: {\n    clickMenu(item) {\n      if (this.$route.path !== item.url) {\n        //如果当前路由跟需要更新的路由不一样\n        this.$router.push(item.url);\n      }\n    }\n  }\n};","map":{"version":3,"names":["name","props","methods","clickMenu","item","$route","path","url","$router","push"],"sources":["src/components/Aside/Aside/AsideItems/index.vue"],"sourcesContent":["<template>\n  <div>\n    <template v-for=\"item in menu\">\n      <!-- 判断没有子路由的 -->\n      <el-menu-item\n        v-if=\"!item.children\"\n        :key=\"item.url\"\n        :index=\"item.name\"\n        @click=\"clickMenu(item)\"\n      >\n        <i :class=\"`el-icon-${item.icon}`\"></i>\n        <span slot=\"title\">{{ item.name }}</span>\n      </el-menu-item>\n      <!-- 有子路由的导航 -->\n      <el-submenu v-else :key=\"item.url\" :index=\"item.name\">\n        <template slot=\"title\">\n          <i :class=\"`el-icon-${item.icon}`\"></i>\n          <span slot=\"title\">{{ item.name }}</span>\n        </template>\n        <!-- 子路由 -->\n        <aside-item :menu=\"item.children\"/>\n      </el-submenu>\n    </template>\n  </div>\n</template>\n\n<script>\n\nexport default {\n  name: \"AsideItem\",\n  props: [\"menu\"],\n  methods: {\n    clickMenu(item) {\n      if (this.$route.path !== item.url) {\n        //如果当前路由跟需要更新的路由不一样\n        this.$router.push(item.url);\n      }\n    },\n  },\n};\n</script>\n<style lang=\"less\">\n.el-menu--collapse .el-menu-item span,\n.el-menu--collapse .el-submenu .el-submenu__title span {\n  height: 0;\n  width: 0;\n  overflow: hidden;\n  visibility: hidden;\n  display: inline-block;\n}\n</style>\n"],"mappings":";AA4BA;EACAA,IAAA;EACAC,KAAA;EACAC,OAAA;IACAC,UAAAC,IAAA;MACA,SAAAC,MAAA,CAAAC,IAAA,KAAAF,IAAA,CAAAG,GAAA;QACA;QACA,KAAAC,OAAA,CAAAC,IAAA,CAAAL,IAAA,CAAAG,GAAA;MACA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}