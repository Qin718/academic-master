{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/esnext.iterator.constructor.js\";\nimport \"core-js/modules/esnext.iterator.filter.js\";\nimport \"core-js/modules/esnext.iterator.for-each.js\";\nimport { message } from \"@/method/message\";\nexport default {\n  name: \"SysProject\",\n  data() {\n    return {\n      //数据参数\n      searchData: {},\n      //搜索数据\n      insertData: {},\n      //新增数据\n      projectData: {},\n      //查看数据\n      userData: {},\n      //创建者数据\n      editData: {},\n      //编辑数据\n\n      //集合参数\n      dataList: [],\n      //页面展示的数据集合\n      selections: [],\n      //多选数组\n\n      //页号参数\n      pageIndex: 1,\n      pageSize: 5,\n      pageSizes: [],\n      totalPage: 0,\n      begin: 0,\n      end: this.pageSize - 1,\n      //文件参数\n      fileList: [],\n      //上传文件，以数组方式上传\n      fileListed: 0,\n      //上传过的文件\n      fileLimit: 5,\n      //文件上传个数限制\n      fileSize: 10,\n      //文件限制大小\n      filesJSON: [],\n      //回显附件路径\n      returnList: [],\n      //返回 文件上传的本地路径\n\n      //窗口显示参数\n      insertWindow: false,\n      lookWindow: false,\n      editWindow: false,\n      fileWindow: false,\n      //其他\n      single: true,\n      //非单个禁用\n      multiple: true,\n      //非多个禁用\n      showSearch: true,\n      // 显示搜索条件\n      dataListFrom: \"getDataList\",\n      //当前数据来源于搜索还是全局\n\n      //表头数据\n      properties: []\n    };\n  },\n  methods: {\n    //改变数组大小\n    sizeChangeHandle(val) {\n      this.pageSize = val;\n      this.SizeOrCurrentChangeAfter();\n    },\n    //改变当前页号\n    CurrentChangeHandle(val) {\n      this.pageIndex = val;\n      this.SizeOrCurrentChangeAfter();\n    },\n    //在更改数组大小或者页号前，判断数据来源\n    SizeOrCurrentChangeAfter() {\n      if (this.dataListFrom === \"getDataList\") this.getDataList();else this.getDataListBySearch();\n    },\n    //查询所有数据\n    getDataList() {\n      this.dataListFrom = \"getDataList\";\n      const pageInfo = this.$getPageInfo(this.pageSize, this.pageIndex);\n      this.$http.post(\"/item/getPageVo\", pageInfo).then(res => {\n        this.cutDataList(res);\n      });\n    },\n    //查询单条数据\n    getDataListBySearch() {\n      this.dataListFrom = \"getDataListBySearch\";\n      const data = {\n        projectBo: this.searchData,\n        pageBo: this.$getPageInfo(this.pageSize, this.pageIndex)\n      };\n      this.$http.post(\"/item/getPageVo/search\", data).then(res => {\n        this.cutDataList(res);\n      });\n    },\n    //刷新页面\n    refresh() {\n      this.$GlobalLoading(true, {\n        text: \"正在重置搜索条件，请稍候...\"\n      });\n      setTimeout(() => {\n        this.searchData = {};\n        this.getDataList();\n        this.$GlobalLoading(false, null);\n      }, 1000);\n    },\n    // 多选框选中数据\n    handleSelectionChange(selection) {\n      this.selections = selection;\n      this.single = selection.length !== 1;\n      this.multiple = !selection.length;\n    },\n    //是否显示上传框\n    changeDialogFormVisibleFile() {\n      this.fileWindow = !this.fileWindow;\n    },\n    //上传前的校验\n    handleBeforeUpload(file) {\n      const uploadTypes = [\"doc\", \"docx\", \"xls\", \"xlsx\", \"ppt\", \"pptx\"];\n      const filetype = file.name.replace(/.+\\./, \"\");\n      const isRightSize = (file.size || 0) / 1024 / 1024 < this.fileSize;\n      if (!isRightSize) {\n        message.error(\"文件大小超过 \" + this.fileSize + \"MB\");\n        return false;\n      }\n      if (uploadTypes.indexOf(filetype.toLowerCase()) === -1) {\n        message.warning(\"请上传后缀名为doc,docx,xls,xlsx,ppt,pptx的附件\");\n        return false;\n      }\n      return true;\n    },\n    //文件数量改变\n    handleChange(fileList) {\n      this.fileList[this.fileListed] = fileList;\n      this.fileListed = this.fileListed + 1;\n    },\n    //超出文件个数的回调\n    handleExceed() {\n      message({\n        type: \"warning\",\n        message: \"超出最大上传文件数量的限制！\"\n      });\n    },\n    //修改项目\n    updateProject() {\n      this.$confirm(\"是否确认修改?修改后项目将回到未审核状态！\", \"提示\", {\n        confirmButtonText: \"确定\",\n        cancelButtonText: \"取消\",\n        type: \"warning\"\n      }).then(() => {\n        let list = this.fileList;\n        if (list.length !== 0) {\n          this.$GlobalLoading(true, {\n            text: '正在上传文件中，请稍后...'\n          });\n          this.$UploadFile(\"/import/file\", list).then(() => {\n            setTimeout(() => {\n              this.$GlobalLoading(false, null);\n            }, 1000);\n          });\n        }\n        this.editWindow = false;\n        const data = {\n          projectBo: this.editData,\n          pageBo: this.$getPageInfo(this.pageSize, this.pageIndex)\n        };\n        this.$http.post(\"/item/update\", data).then(res => {\n          this.cutDataList(res);\n        });\n      });\n    },\n    //分页操作\n    cutDataList(res) {\n      const data = this.$cutPageDataList(res);\n      this.dataList = data.dataList;\n      this.totalPage = data.totalPage;\n    },\n    //查看按钮\n    openLookWindow(item) {\n      this.lookWindow = true;\n      this.projectData = item.project;\n      this.userData = item.user;\n      this.projectData.status = item.status;\n      this.projectData.createTime = item.createTime;\n      this.projectData.updateTime = item.updateTime;\n    },\n    //打开新增页面\n    openInsertWindow() {\n      this.insertWindow = true;\n      this.insertData = {};\n    },\n    //打开编辑页面\n    openEditWindow(item, data) {\n      //判断时多选框中选择，还是单条点击\n      data = item === null ? data : this.selections[0];\n      //打开编辑菜单界面\n      this.editWindow = true;\n      //清空回显数据\n      this.editData = [];\n      //回显数据\n      this.editData = this.$CopyObject(data.project);\n      this.editData.id = data.id;\n      //清空上传列表\n      this.fileList = [];\n      this.fileListed = 0;\n      this.fileWindow = false;\n    },\n    //删除按钮\n    deleteProject(item, data) {\n      const list = [];\n      //判断时多选框中选择，还是单条点击\n      if (item === null) {\n        list.push(data.id);\n      } else {\n        this.selections.forEach(item => list.push(item.id));\n      }\n      this.$confirm(\"是否确认删除?\", \"提示\", {\n        confirmButtonText: \"确定\",\n        cancelButtonText: \"取消\",\n        type: \"warning\"\n      }).then(() => {\n        const data = {\n          list: list,\n          pageBo: this.$getPageInfo(this.pageSize, this.pageIndex)\n        };\n        this.$http.post(\"/item/delete\", data).then(res => {\n          this.cutDataList(res);\n        });\n      }).catch(() => {\n        message({\n          type: \"info\",\n          message: \"已取消删除\"\n        });\n      });\n    },\n    //新增页面的确认键\n    insertProject() {\n      const data = {\n        projectBo: this.insertData,\n        pageBo: this.$getPageInfo(this.pageSize, this.pageIndex)\n      };\n      this.$http.post(\"/item/insert\", data).then(res => {\n        this.cutDataList(res);\n        this.insertWindow = false;\n      });\n    },\n    //初始化页号\n    setPageSize() {\n      this.pageSizes = this.$getPageSize();\n      this.pageSize = this.pageSizes[0];\n    },\n    //获取表头\n    getProperties() {\n      this.properties = this.$getProp(\"/prop/item\");\n    }\n  },\n  mounted() {\n    //获取表头数据\n    this.getProperties();\n    this.setPageSize();\n    this.getDataList();\n  },\n  computed: {\n    //获取打印集合\n    getPrintData() {\n      let data = [];\n      if (this.selections.length === 0) {\n        data = JSON.parse(JSON.stringify(this.dataList));\n      } else {\n        data = JSON.parse(JSON.stringify(this.selections));\n      }\n      return data;\n    },\n    //获取表头\n    getProp() {\n      return this.properties.filter(item => item.checked);\n    }\n  }\n};","map":{"version":3,"names":["message","name","data","searchData","insertData","projectData","userData","editData","dataList","selections","pageIndex","pageSize","pageSizes","totalPage","begin","end","fileList","fileListed","fileLimit","fileSize","filesJSON","returnList","insertWindow","lookWindow","editWindow","fileWindow","single","multiple","showSearch","dataListFrom","properties","methods","sizeChangeHandle","val","SizeOrCurrentChangeAfter","CurrentChangeHandle","getDataList","getDataListBySearch","pageInfo","$getPageInfo","$http","post","then","res","cutDataList","projectBo","pageBo","refresh","$GlobalLoading","text","setTimeout","handleSelectionChange","selection","length","changeDialogFormVisibleFile","handleBeforeUpload","file","uploadTypes","filetype","replace","isRightSize","size","error","indexOf","toLowerCase","warning","handleChange","handleExceed","type","updateProject","$confirm","confirmButtonText","cancelButtonText","list","$UploadFile","$cutPageDataList","openLookWindow","item","project","user","status","createTime","updateTime","openInsertWindow","openEditWindow","$CopyObject","id","deleteProject","push","forEach","catch","insertProject","setPageSize","$getPageSize","getProperties","$getProp","mounted","computed","getPrintData","JSON","parse","stringify","getProp","filter","checked"],"sources":["src/views/sys/SysProject/index.vue"],"sourcesContent":["<template>\n  <el-card class=\"box-card\">\n    <div>\n      \n\n      <!-- 按钮 -->\n      <el-row :gutter=\"10\">\n        <el-col :span=\"1.5\">\n          <el-button v-button=\"':SysProject:insert'\" plain size=\"mini\" type=\"primary\" @click=\"openInsertWindow\">\n            新增\n          </el-button>\n        </el-col>\n        <el-col :span=\"1.5\">\n          <el-button v-button=\"':SysProject:update'\" plain size=\"mini\" type=\"success\" :disabled=\"single\" @click=\"openEditWindow\">\n            修改\n          </el-button>\n        </el-col>\n        <el-col :span=\"1.5\">\n          <el-button v-button=\"':SysProject:delete'\" plain size=\"mini\" type=\"danger\" :disabled=\"multiple\" @click=\"deleteProject\">\n            删除\n          </el-button>\n        </el-col>\n        <el-col :span=\"1.5\">\n          <printTable v-button=\"':SysProject:print'\" :data=\"getPrintData\" :properties=\"properties\"/>\n        </el-col>\n\n        <right-toolbar :columns=\"properties\" :showSearch.sync=\"showSearch\" @queryTable=\"getDataList\"></right-toolbar>\n      </el-row>\n\n      <!-- 数据表单 -->\n      <el-table ref=\"multipleTable\" :data=\"dataList\" border @selection-change=\"handleSelectionChange\">\n        <el-table-column type=\"selection\" width=\"55\"></el-table-column>\n        <el-table-column\n\t        v-for=\"{prop, label, width} in getProp\"\n\t        :key=\"prop\"\n\t        :label=\"label\"\n\t        :prop=\"prop\"\n\t        :width=\"width\"\n\t        sortable>\n        </el-table-column>\n\t      <el-table-column label=\"操作\" width=\"300\">\n          <template v-slot=\"scope\">\n            <el-button size=\"mini\" type=\"primary\" @click=\"openLookWindow(scope.row)\">\n              查看项目\n            </el-button>\n            <el-button size=\"mini\" type=\"danger\" @click=\"deleteProject(null,scope.row)\">\n              删除项目\n            </el-button>\n            <el-button size=\"mini\" @click=\"openEditWindow(null,scope.row)\">\n              修改项目\n            </el-button>\n          </template>\n        </el-table-column>\n      </el-table>\n      <!-- 查看打开的界面 -->\n      <el-dialog title=\"项目详情\" :visible.sync=\"lookWindow\" :model=\"projectData\" width=\"50%\">\n        <el-descriptions title=\"项目信息\">\n          <el-descriptions-item label=\"项目编号\">\n            {{ this.projectData.id }}\n          </el-descriptions-item>\n          <el-descriptions-item label=\"项目名称\">\n            {{ this.projectData.name }}\n          </el-descriptions-item>\n          <el-descriptions-item label=\"项目类型\">\n            {{ this.projectData.type }}\n          </el-descriptions-item>\n          <el-descriptions-item label=\"项目状态\">\n            {{ this.projectData.status }}\n          </el-descriptions-item>\n          <el-descriptions-item label=\"项目创建人\">\n            <el-tag size=\"small\">{{ this.userData.name }}</el-tag>\n          </el-descriptions-item>\n          <el-descriptions-item label=\"项目说明\">\n            {{ this.projectData['remark'] }}\n          </el-descriptions-item>\n        </el-descriptions>\n        <el-descriptions column:2>\n          <el-descriptions-item label=\"创建时间\">\n            {{ this.projectData.createTime }}\n          </el-descriptions-item>\n          <el-descriptions-item label=\"申请资金\">\n            {{ this.projectData['money'] }}\n          </el-descriptions-item>\n        </el-descriptions>\n        <el-descriptions>\n\n          <el-descriptions-item\n            label=\"最近一次修改时间\"\n            prop=\"updateTime\"\n          >{{ this.projectData.updateTime }}\n          </el-descriptions-item\n          >\n        </el-descriptions>\n        <el-divider></el-divider>\n        <el-descriptions title=\"项目创建者信息\">\n          <el-descriptions-item label=\"账号\">\n            {{ this.userData.username }}\n          </el-descriptions-item\n          >\n          <el-descriptions-item label=\"姓名\">\n            <el-tag size=\"small\">{{ this.userData.name }}</el-tag>\n          </el-descriptions-item>\n          <el-descriptions-item label=\"邮箱\">{{\n              this.userData.email\n            }}\n          </el-descriptions-item>\n          <el-descriptions-item label=\"手机号码\">{{\n              this.userData.mobile\n            }}\n          </el-descriptions-item>\n          <el-descriptions-item label=\"账号状态\">{{\n              this.userData.status === 1 ? \"正常\" : \"禁用\"\n            }}\n          </el-descriptions-item>\n        </el-descriptions>\n      </el-dialog>\n      <!-- 新增按钮打开的页面 -->\n      <el-dialog title=\"创建项目\" :visible.sync=\"insertWindow\">\n        <el-form :model=\"insertData\">\n          <el-form-item label=\"项目名称\" label-width=\"120px\">\n            <el-input\n              v-model=\"insertData.name\"\n              placeholder=\"项目名称\"\n              style=\"width: 80%\"\n            ></el-input>\n          </el-form-item>\n          <el-form-item label=\"项目内容\" label-width=\"120px\">\n            <el-input\n              v-model=\"insertData.content\"\n              placeholder=\"项目内容\"\n              style=\"width: 80%\"\n            ></el-input>\n          </el-form-item>\n          <el-form-item label=\"项目类型\" label-width=\"120px\">\n            <el-input\n              v-model=\"insertData.type\"\n              placeholder=\"项目类型\"\n              style=\"width: 80%\"\n            ></el-input>\n          </el-form-item>\n          <el-form-item label=\"申请资金\" label-width=\"120px\">\n            <el-input\n              v-model=\"insertData['money']\"\n              placeholder=\"申请资金\"\n              style=\"width: 80%\"\n            ></el-input>\n          </el-form-item>\n          <el-form-item label=\"项目说明\" label-width=\"120px\">\n            <el-input\n              v-model=\"insertData['remark']\"\n              style=\"width: 80%\"\n              type=\"textarea\"\n            ></el-input>\n          </el-form-item>\n        </el-form>\n        <div slot=\"footer\" class=\"dialog-footer\">\n          <el-button @click=\"insertWindow = false;\">取 消</el-button>\n          <el-button type=\"primary\" @click=\"insertProject()\">确 定</el-button>\n        </div>\n      </el-dialog>\n      <!-- 编辑按钮打开的页面 -->\n      <el-dialog title=\"编辑项目\" :visible.sync=\"editWindow\">\n        <el-form :model=\"editData\">\n          <el-form-item label=\"项目名称\" label-width=\"120px\">\n            <el-input\n              v-model=\"editData.name\"\n              placeholder=\"账号\"\n              style=\"width: 80%\"\n            ></el-input>\n          </el-form-item>\n          <el-form-item label=\"项目内容\" label-width=\"120px\">\n            <el-input\n              v-model=\"editData.content\"\n              placeholder=\"项目内容\"\n              style=\"width: 80%\"\n            ></el-input>\n          </el-form-item>\n          <el-form-item label=\"项目类型\" label-width=\"120px\">\n            <el-input\n              v-model=\"editData.type\"\n              placeholder=\"项目类型\"\n              style=\"width: 80%\"\n            ></el-input>\n          </el-form-item>\n          <el-form-item label=\"申请资金\" label-width=\"120px\">\n            <el-input\n              v-model=\"editData['money']\"\n              placeholder=\"申请资金\"\n              style=\"width: 80%\"\n            ></el-input>\n          </el-form-item>\n          <el-form-item label=\"项目说明\" label-width=\"120px\">\n            <el-input\n              v-model=\"editData['remark']\"\n              style=\"width: 80%\"\n              type=\"textarea\"\n            ></el-input>\n          </el-form-item>\n          <el-form-item label=\"上传附件\" label-width=\"120px\">\n            <el-button @click=\"changeDialogFormVisibleFile()\">上传附件</el-button>\n            <el-upload\n              v-if=\"this.fileWindow\"\n              :auto-upload=\"false\"\n              :before-upload=\"handleBeforeUpload\"\n              :file-list=\"fileList\"\n              :limit=\"fileLimit\"\n              :multiple=\"true\"\n              :on-change=\"handleChange\"\n              :on-exceed=\"handleExceed\"\n              :show-file-list=\"true\"\n              action=\"#\"\n              drag\n              list-type=\"text\"\n              name=\"file\"\n              style=\"margin-top: 10px;\"\n            >\n              <i class=\"el-icon-upload\"></i>\n              <div class=\"el-upload__text\">将文件拖到此处，或<em>点击上传</em></div>\n              <div slot=\"tip\" class=\"el-upload__tip\">只能上传doc/xls/ppt文件，且不超过{{ this.fileSize }}kb</div>\n            </el-upload>\n          </el-form-item>\n\n        </el-form>\n        <div slot=\"footer\" class=\"dialog-footer\">\n          <el-button @click=\"editWindow = false\">取 消</el-button>\n          <el-button type=\"primary\" @click=\"updateProject()\">更 新</el-button>\n        </div>\n      </el-dialog>\n      <!-- 页号 -->\n      <el-pagination\n        :current-page=\"pageIndex\"\n        :page-size=\"pageSize\"\n        :page-sizes=\"pageSizes\"\n        :total=\"totalPage\"\n        layout=\"total ,sizes,prev,pager,next,jumper\"\n        style=\"margin-top: 30px\"\n        @size-change=\"sizeChangeHandle\"\n        @current-change=\"CurrentChangeHandle\"\n      >\n      </el-pagination>\n    </div>\n  </el-card>\n</template>\n<script>\n\nimport {message} from \"@/method/message\";\n\nexport default {\n  name: \"SysProject\",\n  data() {\n    return {\n      //数据参数\n      searchData: {},//搜索数据\n      insertData: {},//新增数据\n      projectData: {},//查看数据\n      userData: {},//创建者数据\n      editData:{},//编辑数据\n\n      //集合参数\n      dataList: [], //页面展示的数据集合\n      selections: [],//多选数组\n\n      //页号参数\n      pageIndex: 1,\n      pageSize: 5,\n      pageSizes: [],\n      totalPage: 0,\n      begin: 0,\n      end: this.pageSize - 1,\n\n      //文件参数\n      fileList: [], //上传文件，以数组方式上传\n      fileListed: 0, //上传过的文件\n      fileLimit: 5, //文件上传个数限制\n      fileSize: 10,//文件限制大小\n      filesJSON: [],//回显附件路径\n      returnList: [],//返回 文件上传的本地路径\n\n      //窗口显示参数\n      insertWindow: false,\n      lookWindow: false,\n      editWindow: false,\n      fileWindow: false,\n\n      //其他\n      single: true,//非单个禁用\n      multiple: true,//非多个禁用\n      showSearch: true,// 显示搜索条件\n      dataListFrom: \"getDataList\",//当前数据来源于搜索还是全局\n\n      //表头数据\n      properties: [],\n    };\n  },\n  methods: {\n    //改变数组大小\n    sizeChangeHandle(val) {\n      this.pageSize = val;\n      this.SizeOrCurrentChangeAfter();\n    },\n    //改变当前页号\n    CurrentChangeHandle(val) {\n      this.pageIndex = val;\n      this.SizeOrCurrentChangeAfter();\n    },\n    //在更改数组大小或者页号前，判断数据来源\n    SizeOrCurrentChangeAfter() {\n      if (this.dataListFrom === \"getDataList\")\n        this.getDataList();\n      else this.getDataListBySearch();\n    },\n\n    //查询所有数据\n    getDataList() {\n      this.dataListFrom = \"getDataList\";\n      const pageInfo = this.$getPageInfo(this.pageSize, this.pageIndex)\n      this.$http.post(\"/item/getPageVo\", pageInfo).then((res) => {\n        this.cutDataList(res);\n      });\n    },\n    //查询单条数据\n    getDataListBySearch() {\n      this.dataListFrom = \"getDataListBySearch\";\n      const data = {\n        projectBo: this.searchData,\n        pageBo: this.$getPageInfo(this.pageSize, this.pageIndex)\n      }\n      this.$http.post(\"/item/getPageVo/search\", data).then((res) => {\n        this.cutDataList(res);\n      });\n    },\n    //刷新页面\n    refresh() {\n      this.$GlobalLoading(true, {text: \"正在重置搜索条件，请稍候...\"});\n      setTimeout(() => {\n        this.searchData = {};\n        this.getDataList();\n        this.$GlobalLoading(false, null);\n      }, 1000);\n    },\n    // 多选框选中数据\n    handleSelectionChange(selection) {\n      this.selections = selection;\n      this.single = selection.length !== 1;\n      this.multiple = !selection.length;\n    },\n\n    //是否显示上传框\n    changeDialogFormVisibleFile() {\n      this.fileWindow = !this.fileWindow\n    },\n    //上传前的校验\n    handleBeforeUpload(file) {\n      const uploadTypes = [\n        \"doc\",\n        \"docx\",\n        \"xls\",\n        \"xlsx\",\n        \"ppt\",\n        \"pptx\",\n      ];\n      const filetype = file.name.replace(/.+\\./, \"\");\n      const isRightSize = (file.size || 0) / 1024 / 1024 < this.fileSize;\n      if (!isRightSize) {\n        message.error(\"文件大小超过 \" + this.fileSize + \"MB\");\n        return false;\n      }\n      if (uploadTypes.indexOf(filetype.toLowerCase()) === -1) {\n        message.warning(\"请上传后缀名为doc,docx,xls,xlsx,ppt,pptx的附件\");\n        return false;\n      }\n      return true;\n    },\n    //文件数量改变\n    handleChange(fileList) {\n      this.fileList[this.fileListed] = fileList;\n      this.fileListed = this.fileListed + 1\n    },\n    //超出文件个数的回调\n    handleExceed() {\n      message({\n        type: \"warning\",\n        message: \"超出最大上传文件数量的限制！\",\n      });\n    },\n    //修改项目\n    updateProject() {\n      this.$confirm(\"是否确认修改?修改后项目将回到未审核状态！\", \"提示\", {\n        confirmButtonText: \"确定\",\n        cancelButtonText: \"取消\",\n        type: \"warning\",\n      }).then(() => {\n        let list = this.fileList;\n        if (list.length !== 0) {\n          this.$GlobalLoading(true,{text: '正在上传文件中，请稍后...',})\n          this.$UploadFile(\"/import/file\", list).then(() => {\n            setTimeout(()=>{\n              this.$GlobalLoading(false,null);\n            },1000)\n          })\n        }\n        this.editWindow = false;\n        const data = {\n          projectBo: this.editData,\n          pageBo: this.$getPageInfo(this.pageSize, this.pageIndex)\n        }\n        this.$http.post(\"/item/update\", data).then((res) => {\n          this.cutDataList(res);\n        });\n      });\n    },\n\n    //分页操作\n    cutDataList(res) {\n      const data = this.$cutPageDataList(res)\n      this.dataList = data.dataList\n      this.totalPage = data.totalPage\n    },\n\n    //查看按钮\n    openLookWindow(item) {\n      this.lookWindow = true;\n      this.projectData = item.project;\n      this.userData = item.user;\n      this.projectData.status = item.status\n      this.projectData.createTime = item.createTime\n      this.projectData.updateTime = item.updateTime\n    },\n    //打开新增页面\n    openInsertWindow() {\n      this.insertWindow = true\n      this.insertData = {}\n    },\n    //打开编辑页面\n    openEditWindow(item, data) {\n      //判断时多选框中选择，还是单条点击\n      data = item === null ? data : this.selections[0];\n      //打开编辑菜单界面\n      this.editWindow = true;\n      //清空回显数据\n      this.editData = [];\n      //回显数据\n      this.editData = this.$CopyObject(data.project);\n      this.editData.id = data.id;\n      //清空上传列表\n      this.fileList = [];\n      this.fileListed = 0\n      this.fileWindow = false;\n    },\n\n    //删除按钮\n    deleteProject(item,data) {\n      const list = []\n      //判断时多选框中选择，还是单条点击\n      if(item === null) {\n        list.push(data.id)\n      }else {\n        this.selections.forEach(item => list.push(item.id))\n      }\n      this.$confirm(\"是否确认删除?\", \"提示\", {confirmButtonText: \"确定\",cancelButtonText: \"取消\",type: \"warning\"})\n        .then(() => {\n          const data = {\n            list: list,\n            pageBo: this.$getPageInfo(this.pageSize, this.pageIndex)\n          }\n          this.$http.post(\"/item/delete\", data).then((res) => {\n            this.cutDataList(res);\n          });\n        })\n        .catch(() => {\n          message({type: \"info\", message: \"已取消删除\",});\n        });\n    },\n    //新增页面的确认键\n    insertProject() {\n      const data = {\n        projectBo: this.insertData,\n        pageBo: this.$getPageInfo(this.pageSize, this.pageIndex)\n      }\n      this.$http.post(\"/item/insert\", data).then((res) => {\n        this.cutDataList(res)\n        this.insertWindow = false\n      });\n    },\n\n    //初始化页号\n    setPageSize() {\n      this.pageSizes = this.$getPageSize()\n      this.pageSize = this.pageSizes[0]\n    },\n    //获取表头\n    getProperties() {\n      this.properties = this.$getProp(\"/prop/item\")\n    }\n  },\n  mounted() {\n    //获取表头数据\n    this.getProperties();\n\t  this.setPageSize();\n    this.getDataList();\n  },\n  computed: {\n    //获取打印集合\n    getPrintData() {\n      let data = []\n      if (this.selections.length === 0) {\n        data = JSON.parse(JSON.stringify(this.dataList));\n      } else {\n        data = JSON.parse(JSON.stringify(this.selections));\n      }\n      return data;\n\t\t},\n\t\t//获取表头\n\t\tgetProp() {\n\t\t\treturn this.properties.filter(item => item.checked);\n\t\t}\n  }\n};\n</script>\n"],"mappings":";;;;AAqPA,SAAAA,OAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACA;MACAC,UAAA;MAAA;MACAC,UAAA;MAAA;MACAC,WAAA;MAAA;MACAC,QAAA;MAAA;MACAC,QAAA;MAAA;;MAEA;MACAC,QAAA;MAAA;MACAC,UAAA;MAAA;;MAEA;MACAC,SAAA;MACAC,QAAA;MACAC,SAAA;MACAC,SAAA;MACAC,KAAA;MACAC,GAAA,OAAAJ,QAAA;MAEA;MACAK,QAAA;MAAA;MACAC,UAAA;MAAA;MACAC,SAAA;MAAA;MACAC,QAAA;MAAA;MACAC,SAAA;MAAA;MACAC,UAAA;MAAA;;MAEA;MACAC,YAAA;MACAC,UAAA;MACAC,UAAA;MACAC,UAAA;MAEA;MACAC,MAAA;MAAA;MACAC,QAAA;MAAA;