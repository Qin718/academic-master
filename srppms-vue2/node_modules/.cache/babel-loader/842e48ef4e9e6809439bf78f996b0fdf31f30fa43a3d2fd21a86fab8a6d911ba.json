{"ast":null,"code":"import \"core-js/modules/esnext.iterator.constructor.js\";\nimport \"core-js/modules/esnext.iterator.filter.js\";\nexport default {\n  name: \"SysVirtualLogin\",\n  data() {\n    return {\n      //数据参数\n      searchData: {},\n      //搜索数据\n\n      //集合参数\n      dataList: [],\n      //页面展示的数据集合\n\n      //页号参数\n      pageIndex: 1,\n      pageSize: 5,\n      pageSizes: [],\n      totalPage: 0,\n      begin: 0,\n      end: this.pageSize - 1,\n      //其他\n      showSearch: true,\n      // 显示搜索条件\n      dataListFrom: \"getDataList\",\n      //当前数据来源于搜索还是全局\n\n      //表头数据\n      properties: []\n    };\n  },\n  methods: {\n    //改变数组大小\n    sizeChangeHandle(val) {\n      this.pageSize = val;\n      this.SizeOrCurrentChangeAfter();\n    },\n    //改变当前页号\n    CurrentChangeHandle(val) {\n      this.pageIndex = val;\n      this.SizeOrCurrentChangeAfter();\n    },\n    //在更改数组大小或者页号前，判断数据来源\n    SizeOrCurrentChangeAfter() {\n      if (this.dataListFrom === \"getDataList\") this.getDataList();else this.getDataListBySearch();\n    },\n    //查询所有数据\n    getDataList() {\n      this.dataListFrom = \"getDataList\";\n      const pageInfo = this.$getPageInfo(this.pageSize, this.pageIndex);\n      this.$http.post(\"/user/getPageVo\", pageInfo).then(res => {\n        this.cutDataList(res);\n      });\n    },\n    //查询单条数据\n    getDataListBySearch() {\n      this.dataListFrom = \"getDataListBySearch\";\n      const data = {\n        pageBo: this.$getPageInfo(this.pageSize, this.pageIndex),\n        userBo: this.searchData\n      };\n      this.$http.post(\"/user/getPageVo/search\", data).then(res => {\n        this.cutDataList(res);\n      });\n    },\n    //分页操作\n    cutDataList(res) {\n      const data = this.$cutPageDataList(res);\n      this.dataList = data.dataList;\n      this.totalPage = data.totalPage;\n    },\n    //虚拟登录\n    handleLogin(item) {\n      this.$http.post(\"/login/virtualLogin/\" + item).then(res => {\n        if (res === null) {\n          return;\n        }\n        const {\n          href\n        } = this.$router.resolve({\n          path: \"/\",\n          query: {\n            \"token\": res[\"token\"],\n            \"username\": res[\"username\"],\n            \"account\": res[\"account\"],\n            \"tokenName\": res[\"tokenName\"]\n          }\n        });\n        window.open(href, '_blank');\n      });\n    },\n    //刷新页面\n    refresh() {\n      this.$GlobalLoading(true, {\n        text: \"正在重置搜索条件，请稍候...\"\n      });\n      setTimeout(() => {\n        this.searchData = {};\n        this.getDataList();\n        this.$GlobalLoading(false, null);\n      }, 1000);\n    },\n    //初始化页号\n    setPageSize() {\n      this.pageSizes = this.$getPageSize();\n      this.pageSize = this.pageSizes[0];\n    },\n    //获取表头\n    getProperties() {\n      this.properties = this.$getProp(\"/prop/user\");\n    }\n  },\n  mounted() {\n    this.getProperties();\n    this.setPageSize();\n    this.getDataList();\n  },\n  computed: {\n    //获取打印集合\n    getPrintData() {\n      return JSON.parse(JSON.stringify(this.dataList));\n    },\n    //获取表头\n    getProp() {\n      return this.properties.filter(item => item.checked);\n    }\n  }\n};","map":{"version":3,"names":["name","data","searchData","dataList","pageIndex","pageSize","pageSizes","totalPage","begin","end","showSearch","dataListFrom","properties","methods","sizeChangeHandle","val","SizeOrCurrentChangeAfter","CurrentChangeHandle","getDataList","getDataListBySearch","pageInfo","$getPageInfo","$http","post","then","res","cutDataList","pageBo","userBo","$cutPageDataList","handleLogin","item","href","$router","resolve","path","query","window","open","refresh","$GlobalLoading","text","setTimeout","setPageSize","$getPageSize","getProperties","$getProp","mounted","computed","getPrintData","JSON","parse","stringify","getProp","filter","checked"],"sources":["src/views/sys/SysVirtualLogin/index.vue"],"sourcesContent":["<template>\n  <el-card class=\"box-card\">\n    <div>\n      <!-- 搜索框 -->\n      <el-form v-show=\"showSearch\" ref=\"searchData\" size=\"small\" :inline=\"true\" :model=\"searchData\" class=\"demo-form-inline\">\n        <el-form-item label=\"用户名\" style=\"width: 23%\">\n          <el-input v-model=\"searchData.username\" placeholder=\"用户名\" clearable maxlength=\"64\"/>\n        </el-form-item>\n        <el-form-item label=\"账号\" style=\"width: 23%\">\n          <el-input v-model=\"searchData.account\" placeholder=\"账号\" clearable maxlength=\"64\"/>\n        </el-form-item>\n        <el-form-item label=\"姓名\" style=\"width: 23%\">\n          <el-input v-model=\"searchData.name\" placeholder=\"姓名\" clearable maxlength=\"64\"/>\n        </el-form-item>\n        <el-form-item label=\"邮箱\" style=\"width: 23%\">\n          <el-input v-model=\"searchData.email\" placeholder=\"邮箱\" clearable maxlength=\"64\"/>\n        </el-form-item>\n        <el-form-item label=\"手机号\" style=\"width: 23%\">\n          <el-input v-model=\"searchData.mobile\" placeholder=\"手机号\" clearable maxlength=\"64\"/>\n        </el-form-item>\n        <el-form-item label=\"状态\" style=\"width: 23%\">\n          <el-select v-model=\"searchData.status\" clearable placeholder=\"状态\">\n            <el-option label=\"正常\" value=\"正常\"></el-option>\n            <el-option label=\"禁用\" value=\"禁用\"></el-option>\n          </el-select>\n        </el-form-item>\n        <el-form-item label=\"性别\" style=\"width: 23%\">\n          <el-select v-model=\"searchData.sex\" clearable placeholder=\"性别\">\n            <el-option label=\"男\" value=\"男\"></el-option>\n            <el-option label=\"女\" value=\"女\"></el-option>\n          </el-select>\n        </el-form-item>\n        <el-form-item>\n          <el-button icon=\"el-icon-search\" type=\"primary\" @click=\"getDataListBySearch\">查询</el-button>\n          <el-button icon=\"el-icon-refresh\" @click=\"refresh\">重置</el-button>\n        </el-form-item>\n      </el-form>\n\n      <!-- 按钮 -->\n      <el-row :gutter=\"10\">\n        <el-col :span=\"1.5\">\n          <printTable :data=\"getPrintData\" :properties=\"properties\"/>\n        </el-col>\n\n        <right-toolbar :columns=\"properties\" :showSearch.sync=\"showSearch\" @queryTable=\"getDataList\"></right-toolbar>\n      </el-row>\n\n      <!-- 角色数据表单 -->\n      <el-table :data=\"dataList\" border>\n        <el-table-column\n\t        v-for=\"{prop, label, width} in getProp\"\n\t        :key=\"prop\"\n\t        :label=\"label\"\n\t        :prop=\"prop\"\n\t        :width=\"width\"\n\t        sortable>\n        </el-table-column>\n\t      <el-table-column label=\"操作\" width=\"120\">\n          <template v-slot=\"scope\">\n            <el-button size=\"mini\" type=\"primary\" @click=\"handleLogin(scope.row.id)\">\n              虚拟登录\n            </el-button>\n          </template>\n        </el-table-column>\n      </el-table>\n      <!-- 页号 -->\n      <el-pagination\n        :current-page=\"pageIndex\"\n        :page-size=\"pageSize\"\n        :page-sizes=\"pageSizes\"\n        :total=\"totalPage\"\n        layout=\"total ,sizes,prev,pager,next,jumper\"\n        style=\"margin-top: 30px\"\n        @size-change=\"sizeChangeHandle\"\n        @current-change=\"CurrentChangeHandle\"\n      >\n      </el-pagination>\n    </div>\n  </el-card>\n</template>\n<script>\n\n\nexport default {\n  name: \"SysVirtualLogin\",\n  data() {\n    return {\n      //数据参数\n      searchData: {},//搜索数据\n\n      //集合参数\n      dataList: [], //页面展示的数据集合\n\n      //页号参数\n      pageIndex: 1,\n      pageSize: 5,\n      pageSizes: [],\n      totalPage: 0,\n      begin: 0,\n      end: this.pageSize - 1,\n\n      //其他\n      showSearch: true,// 显示搜索条件\n      dataListFrom: \"getDataList\",//当前数据来源于搜索还是全局\n\n      //表头数据\n      properties: [],\n    };\n  },\n  methods: {\n    //改变数组大小\n    sizeChangeHandle(val) {\n      this.pageSize = val;\n      this.SizeOrCurrentChangeAfter();\n    },\n    //改变当前页号\n    CurrentChangeHandle(val) {\n      this.pageIndex = val;\n      this.SizeOrCurrentChangeAfter();\n    },\n    //在更改数组大小或者页号前，判断数据来源\n    SizeOrCurrentChangeAfter() {\n      if (this.dataListFrom === \"getDataList\")\n        this.getDataList();\n      else this.getDataListBySearch();\n    },\n\n    //查询所有数据\n    getDataList() {\n      this.dataListFrom = \"getDataList\";\n      const pageInfo = this.$getPageInfo(this.pageSize, this.pageIndex)\n      this.$http.post(\"/user/getPageVo\", pageInfo).then((res) => {\n        this.cutDataList(res);\n      });\n    },\n    //查询单条数据\n    getDataListBySearch() {\n      this.dataListFrom = \"getDataListBySearch\";\n      const data = {\n        pageBo: this.$getPageInfo(this.pageSize, this.pageIndex),\n        userBo: this.searchData\n      }\n      this.$http.post(\"/user/getPageVo/search\", data).then((res) => {\n        this.cutDataList(res);\n      });\n    },\n\n    //分页操作\n    cutDataList(res) {\n      const data = this.$cutPageDataList(res)\n      this.dataList = data.dataList\n      this.totalPage = data.totalPage\n    },\n\n    //虚拟登录\n    handleLogin(item) {\n      this.$http.post(\"/login/virtualLogin/\" + item).then((res) => {\n        if(res === null){\n          return;\n        }\n        const {href} = this.$router.resolve({\n          path: \"/\",\n          query: {\n            \"token\": res[\"token\"],\n            \"username\": res[\"username\"],\n            \"account\": res[\"account\"],\n            \"tokenName\": res[\"tokenName\"]\n          }\n        });\n        window.open(href, '_blank');\n      });\n    },\n    //刷新页面\n    refresh() {\n      this.$GlobalLoading(true, {text: \"正在重置搜索条件，请稍候...\"});\n      setTimeout(() => {\n        this.searchData = {};\n        this.getDataList();\n        this.$GlobalLoading(false, null);\n      }, 1000);\n    },\n\n    //初始化页号\n    setPageSize() {\n      this.pageSizes = this.$getPageSize()\n      this.pageSize = this.pageSizes[0]\n    },\n\n    //获取表头\n    getProperties() {\n      this.properties = this.$getProp(\"/prop/user\")\n    }\n  },\n  mounted() {\n    this.getProperties();\n\t  this.setPageSize();\n    this.getDataList();\n  },\n  computed: {\n    //获取打印集合\n    getPrintData() {\n      return JSON.parse(JSON.stringify(this.dataList));\n\t\t},\n\t\t//获取表头\n\t\tgetProp() {\n\t\t\treturn this.properties.filter(item => item.checked);\n\t\t}\n  },\n};\n</script>\n"],"mappings":";;AAmFA;EACAA,IAAA;EACAC,KAAA;IACA;MACA;MACAC,UAAA;MAAA;;MAEA;MACAC,QAAA;MAAA;;MAEA;MACAC,SAAA;MACAC,QAAA;MACAC,SAAA;MACAC,SAAA;MACAC,KAAA;MACAC,GAAA,OAAAJ,QAAA;MAEA;MACAK,UAAA;MAAA;MACAC,YAAA;MAAA;;MAEA;MACAC,UAAA;IACA;EACA;EACAC,OAAA;IACA;IACAC,iBAAAC,GAAA;MACA,KAAAV,QAAA,GAAAU,GAAA;MACA,KAAAC,wBAAA;IACA;IACA;IACAC,oBAAAF,GAAA;MACA,KAAAX,SAAA,GAAAW,GAAA;MACA,KAAAC,wBAAA;IACA;IACA;IACAA,yBAAA;MACA,SAAAL,YAAA,oBACA,KAAAO,WAAA,QACA,KAAAC,mBAAA;IACA;IAEA;IACAD,YAAA;MACA,KAAAP,YAAA;MACA,MAAAS,QAAA,QAAAC,YAAA,MAAAhB,QAAA,OAAAD,SAAA;MACA,KAAAkB,KAAA,CAAAC,IAAA,oBAAAH,QAAA,EAAAI,IAAA,CAAAC,GAAA;QACA,KAAAC,WAAA,CAAAD,GAAA;MACA;IACA;IACA;IACAN,oBAAA;MACA,KAAAR,YAAA;MACA,MAAAV,IAAA;QACA0B,MAAA,OAAAN,YAAA,MAAAhB,QAAA,OAAAD,SAAA;QACAwB,MAAA,OAAA1B;MACA;MACA,KAAAoB,KAAA,CAAAC,IAAA,2BAAAtB,IAAA,EAAAuB,IAAA,CAAAC,GAAA;QACA,KAAAC,WAAA,CAAAD,GAAA;MACA;IACA;IAEA;IACAC,YAAAD,GAAA;MACA,MAAAxB,IAAA,QAAA4B,gBAAA,CAAAJ,GAAA;MACA,KAAAtB,QAAA,GAAAF,IAAA,CAAAE,QAAA;MACA,KAAAI,SAAA,GAAAN,IAAA,CAAAM,SAAA;IACA;IAEA;IACAuB,YAAAC,IAAA;MACA,KAAAT,KAAA,CAAAC,IAAA,0BAAAQ,IAAA,EAAAP,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA;UACA;QACA;QACA;UAAAO;QAAA,SAAAC,OAAA,CAAAC,OAAA;UACAC,IAAA;UACAC,KAAA;YACA,SAAAX,GAAA;YACA,YAAAA,GAAA;YACA,WAAAA,GAAA;YACA,aAAAA,GAAA;UACA;QACA;QACAY,MAAA,CAAAC,IAAA,CAAAN,IAAA;MACA;IACA;IACA;IACAO,QAAA;MACA,KAAAC,cAAA;QAAAC,IAAA;MAAA;MACAC,UAAA;QACA,KAAAxC,UAAA;QACA,KAAAgB,WAAA;QACA,KAAAsB,cAAA;MACA;IACA;IAEA;IACAG,YAAA;MACA,KAAArC,SAAA,QAAAsC,YAAA;MACA,KAAAvC,QAAA,QAAAC,SAAA;IACA;IAEA;IACAuC,cAAA;MACA,KAAAjC,UAAA,QAAAkC,QAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAF,aAAA;IACA,KAAAF,WAAA;IACA,KAAAzB,WAAA;EACA;EACA8B,QAAA;IACA;I