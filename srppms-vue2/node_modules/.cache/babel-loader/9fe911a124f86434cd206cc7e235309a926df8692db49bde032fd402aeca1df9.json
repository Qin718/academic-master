{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { mapGetters } from \"vuex\";\nimport store from \"@/store\";\nexport default {\n  name: \"commonTab\",\n  data() {\n    return {};\n  },\n  computed: {\n    ...mapGetters([\"commonTags\"])\n  },\n  methods: {\n    changeMenu(item) {\n      this.$router.push(item.url);\n    },\n    closeMenu(item) {\n      //关闭菜单\n      store.dispatch('app/closeMenu', item);\n      //动态的处理路由，关闭当前页面，定位到首页\n      if (this.$route.path !== item.url) {\n        return;\n      }\n      this.$router.push(\"/Index\");\n    }\n  },\n  //实现滚动条\n  directives: {\n    \"horizontal-scroll\": {\n      bind: function (el) {\n        el.addEventListener(\"wheel\", function (event) {\n          event.preventDefault();\n          el.scrollLeft = el.scrollLeft + event.deltaY;\n        });\n      }\n    }\n  }\n};","map":{"version":3,"names":["mapGetters","store","name","data","computed","methods","changeMenu","item","$router","push","url","closeMenu","dispatch","$route","path","directives","bind","el","addEventListener","event","preventDefault","scrollLeft","deltaY"],"sources":["src/components/CommonTab/index.vue"],"sourcesContent":["<template>\n  <div class=\"tabs\">\n    <div v-horizontal-scroll class=\"tabs-container\" style=\"margin-left: 1%\">\n      <el-tag\n        v-for=\"(item) in commonTags\"\n        :key=\"item.url\"\n        :closable=\"item.name !== '首页'\"\n        :effect=\"$route.path === item.url ? 'dark' : 'plain'\"\n        @click=\"changeMenu(item)\"\n        @close=\"closeMenu(item)\"\n      >\n        {{ item.name }}\n      </el-tag>\n    </div>\n  </div>\n</template>\n<script>\nimport {mapGetters} from \"vuex\";\nimport store from \"@/store\";\n\nexport default {\n  name: \"commonTab\",\n  data() {\n    return {};\n  },\n  computed: {\n    ...mapGetters([\"commonTags\"])\n  },\n  methods: {\n    changeMenu(item) {\n      this.$router.push(item.url);\n    },\n    closeMenu(item) {\n      //关闭菜单\n      store.dispatch('app/closeMenu',item)\n      //动态的处理路由，关闭当前页面，定位到首页\n      if (this.$route.path !== item.url) {\n        return;\n      }\n      this.$router.push(\"/Index\");\n    },\n  },\n  //实现滚动条\n  directives: {\n    \"horizontal-scroll\": {\n      bind: function (el) {\n        el.addEventListener(\"wheel\", function (event) {\n          event.preventDefault();\n          el.scrollLeft = el.scrollLeft + event.deltaY;\n        });\n      },\n    },\n  },\n};\n</script>\n<style lang=\"less\" scoped>\n.tabs {\n  position: relative;\n  overflow: hidden;\n  background: #fff;\n  box-shadow: 0 5px 10px #ddd;\n  padding-bottom: 5px;\n  padding-top: 5px;\n  padding-left: 10px;\n\n  .el-tag {\n    margin-right: 15px;\n    cursor: pointer;\n  }\n}\n\n.tabs-container {\n  width: 100%;\n  height: 100%;\n  overflow-x: scroll;\n  overflow-y: hidden;\n  white-space: nowrap;\n  display: flex;\n}\n\n.tabs-container::-webkit-scrollbar {\n  display: none;\n}\n</style>\n"],"mappings":";AAiBA,SAAAA,UAAA;AACA,OAAAC,KAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;EACA;EACAC,QAAA;IACA,GAAAJ,UAAA;EACA;EACAK,OAAA;IACAC,WAAAC,IAAA;MACA,KAAAC,OAAA,CAAAC,IAAA,CAAAF,IAAA,CAAAG,GAAA;IACA;IACAC,UAAAJ,IAAA;MACA;MACAN,KAAA,CAAAW,QAAA,kBAAAL,IAAA;MACA;MACA,SAAAM,MAAA,CAAAC,IAAA,KAAAP,IAAA,CAAAG,GAAA;QACA;MACA;MACA,KAAAF,OAAA,CAAAC,IAAA;IACA;EACA;EACA;EACAM,UAAA;IACA;MACAC,IAAA,WAAAA,CAAAC,EAAA;QACAA,EAAA,CAAAC,gBAAA,oBAAAC,KAAA;UACAA,KAAA,CAAAC,cAAA;UACAH,EAAA,CAAAI,UAAA,GAAAJ,EAAA,CAAAI,UAAA,GAAAF,KAAA,CAAAG,MAAA;QACA;MACA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}