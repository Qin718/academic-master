{"ast":null,"code":"import \"core-js/modules/esnext.iterator.constructor.js\";\nimport \"core-js/modules/esnext.iterator.filter.js\";\nexport default {\n  name: \"SysInterface\",\n  data() {\n    return {\n      //集合参数\n      dataList: [],\n      //页面展示的数据集合\n\n      //页号参数\n      pageIndex: 1,\n      pageSize: 5,\n      pageSizes: [],\n      totalPage: 0,\n      begin: 0,\n      end: this.pageSize - 1,\n      //表头数据\n      properties: []\n    };\n  },\n  methods: {\n    //改变数组大小\n    sizeChangeHandle(val) {\n      this.pageSize = val;\n      this.getDataList();\n    },\n    //改变当前页号\n    CurrentChangeHandle(val) {\n      this.pageIndex = val;\n      this.getDataList();\n    },\n    //分页操作\n    cutDataList(res) {\n      const data = this.$cutPageDataList(res);\n      this.dataList = data.dataList;\n      this.totalPage = data.totalPage;\n    },\n    //查询所有数据\n    getDataList() {\n      const pageInfo = this.$getPageInfo(this.pageSize, this.pageIndex);\n      this.$http.post(\"/interface/getPageVo\", pageInfo).then(res => {\n        this.cutDataList(res);\n      });\n    },\n    //初始化页号\n    setPageSize() {\n      this.pageSizes = this.$getPageSize();\n      this.pageSize = this.pageSizes[0];\n    },\n    //获取表头\n    getProperties() {\n      this.properties = this.$getProp(\"/prop/interface\");\n    }\n  },\n  computed: {\n    //获取打印集合\n    getPrintData() {\n      return JSON.parse(JSON.stringify(this.dataList));\n    },\n    //获取表头\n    getProp() {\n      return this.properties.filter(item => item.checked);\n    }\n  },\n  mounted() {\n    //获取表头数据\n    this.getProperties();\n    this.setPageSize();\n    this.getDataList();\n  }\n};","map":{"version":3,"names":["name","data","dataList","pageIndex","pageSize","pageSizes","totalPage","begin","end","properties","methods","sizeChangeHandle","val","getDataList","CurrentChangeHandle","cutDataList","res","$cutPageDataList","pageInfo","$getPageInfo","$http","post","then","setPageSize","$getPageSize","getProperties","$getProp","computed","getPrintData","JSON","parse","stringify","getProp","filter","item","checked","mounted"],"sources":["src/views/sys/SysInterface/index.vue"],"sourcesContent":["<template>\n  <el-card class=\"box-card\">\n    <div>\n      <!-- 按钮 -->\n      <el-row :gutter=\"10\">\n        <el-col :span=\"1.5\">\n          <printTable v-button=\"':SysInterface:print'\" :data=\"getPrintData\" :properties=\"properties\"/>\n        </el-col>\n\n        <right-toolbar :columns=\"properties\" :searchButton=\"false\" @queryTable=\"getDataList\"></right-toolbar>\n      </el-row>\n\n      <!-- 参数数据表单 -->\n      <el-table ref=\"multipleTable\" :data=\"dataList\" border>\n        <el-table-column\n\t        v-for=\"{prop, label, width} in getProp\"\n\t        :key=\"prop\"\n\t        :label=\"label\"\n\t        :prop=\"prop\"\n\t        :width=\"width\"\n\t        sortable>\n        </el-table-column>\n      </el-table>\n      <!-- 页号 -->\n      <el-pagination\n        :current-page=\"pageIndex\"\n        :page-size=\"pageSize\"\n        :page-sizes=\"pageSizes\"\n        :total=\"totalPage\"\n        layout=\"total ,sizes,prev,pager,next,jumper\"\n        style=\"margin-top: 30px\"\n        @size-change=\"sizeChangeHandle\"\n        @current-change=\"CurrentChangeHandle\"\n      >\n      </el-pagination>\n    </div>\n  </el-card>\n</template>\n<script>\n\nexport default {\n  name: \"SysInterface\",\n  data() {\n    return {\n      //集合参数\n      dataList: [], //页面展示的数据集合\n\n      //页号参数\n      pageIndex: 1,\n      pageSize: 5,\n      pageSizes: [],\n      totalPage: 0,\n      begin: 0,\n      end: this.pageSize - 1,\n\n      //表头数据\n      properties: [],\n    };\n  },\n  methods: {\n    //改变数组大小\n    sizeChangeHandle(val) {\n      this.pageSize = val;\n      this.getDataList();\n    },\n    //改变当前页号\n    CurrentChangeHandle(val) {\n      this.pageIndex = val;\n      this.getDataList();\n    },\n\n    //分页操作\n    cutDataList(res) {\n      const data = this.$cutPageDataList(res)\n      this.dataList = data.dataList\n      this.totalPage = data.totalPage\n    },\n\n    //查询所有数据\n    getDataList() {\n      const pageInfo = this.$getPageInfo(this.pageSize, this.pageIndex)\n      this.$http.post(\"/interface/getPageVo\", pageInfo).then((res) => {\n        this.cutDataList(res);\n      });\n    },\n\n    //初始化页号\n    setPageSize() {\n      this.pageSizes = this.$getPageSize()\n      this.pageSize = this.pageSizes[0]\n    },\n\n    //获取表头\n    getProperties() {\n      this.properties = this.$getProp(\"/prop/interface\")\n    }\n  },\n  computed: {\n    //获取打印集合\n    getPrintData() {\n      return JSON.parse(JSON.stringify(this.dataList));\n\t\t},\n\t\t//获取表头\n\t\tgetProp() {\n\t\t\treturn this.properties.filter(item => item.checked);\n\t\t}\n  },\n  mounted() {\n    //获取表头数据\n    this.getProperties();\n\t  this.setPageSize();\n    this.getDataList();\n  },\n};\n</script>\n"],"mappings":";;AAwCA;EACAA,IAAA;EACAC,KAAA;IACA;MACA;MACAC,QAAA;MAAA;;MAEA;MACAC,SAAA;MACAC,QAAA;MACAC,SAAA;MACAC,SAAA;MACAC,KAAA;MACAC,GAAA,OAAAJ,QAAA;MAEA;MACAK,UAAA;IACA;EACA;EACAC,OAAA;IACA;IACAC,iBAAAC,GAAA;MACA,KAAAR,QAAA,GAAAQ,GAAA;MACA,KAAAC,WAAA;IACA;IACA;IACAC,oBAAAF,GAAA;MACA,KAAAT,SAAA,GAAAS,GAAA;MACA,KAAAC,WAAA;IACA;IAEA;IACAE,YAAAC,GAAA;MACA,MAAAf,IAAA,QAAAgB,gBAAA,CAAAD,GAAA;MACA,KAAAd,QAAA,GAAAD,IAAA,CAAAC,QAAA;MACA,KAAAI,SAAA,GAAAL,IAAA,CAAAK,SAAA;IACA;IAEA;IACAO,YAAA;MACA,MAAAK,QAAA,QAAAC,YAAA,MAAAf,QAAA,OAAAD,SAAA;MACA,KAAAiB,KAAA,CAAAC,IAAA,yBAAAH,QAAA,EAAAI,IAAA,CAAAN,GAAA;QACA,KAAAD,WAAA,CAAAC,GAAA;MACA;IACA;IAEA;IACAO,YAAA;MACA,KAAAlB,SAAA,QAAAmB,YAAA;MACA,KAAApB,QAAA,QAAAC,SAAA;IACA;IAEA;IACAoB,cAAA;MACA,KAAAhB,UAAA,QAAAiB,QAAA;IACA;EACA;EACAC,QAAA;IACA;IACAC,aAAA;MACA,OAAAC,IAAA,CAAAC,KAAA,CAAAD,IAAA,CAAAE,SAAA,MAAA7B,QAAA;IACA;IACA;IACA8B,QAAA;MACA,YAAAvB,UAAA,CAAAwB,MAAA,CAAAC,IAAA,IAAAA,IAAA,CAAAC,OAAA;IACA;EACA;EACAC,QAAA;IACA;IACA,KAAAX,aAAA;IACA,KAAAF,WAAA;IACA,KAAAV,WAAA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDepen