eIndex),\n        bo: this.searchData\n      }\n      this.$http.post(\"/log/getPageVo/search\", data).then((res) => {\n        this.cutDataList(res);\n      });\n    },\n\n    //分页操作\n    cutDataList(res) {\n      const data = this.$cutPageDataList(res)\n      this.dataList = data.dataList\n      this.totalPage = data.totalPage\n    },\n    // 多选框选中数据\n    handleSelectionChange(selection) {\n      this.selections = selection;\n      this.multiple = !selection.length;\n    },\n\n    //初始化页号\n    setPageSize() {\n      this.pageSizes = this.$getPageSize()\n      this.pageSize = this.pageSizes[0]\n    },\n\n    //删除日志\n    deleteLog() {\n      const list = []\n      //判断时多选框中选择，还是单条点击\n      this.selections.forEach(item => list.push(item.id))\n      const data = {\n        list: list,\n        pageBo: this.$getPageInfo(this.pageSize, this.pageIndex)\n      }\n      this.$http.post(\"/log/delete\", data).then((res) => {\n        //分页操作\n        this.cutDataList(res)\n      });\n    },\n\n    //获取表头\n    getProperties() {\n      this.properties = this.$getProp(\"/prop/log\")\n    }\n  },\n  mounted() {\n    //获取表头数据\n    this.getProperties();\n\t  this.setPageSize();\n    this.getDataList();\n  },\n};\n</script>\n"],"mappings":";;;;AAoFA;EACAA,IAAA;EACAC,KAAA;IACA;MACA;MACAC,UAAA;MAAA;;MAEA;MACAC,QAAA;MAAA;MACAC,UAAA;MAAA;;MAEA;MACAC,SAAA;MACAC,QAAA;MACAC,SAAA;MACAC,SAAA;MACAC,KAAA;MACAC,GAAA,OAAAJ,QAAA;MAEA;MACAK,QAAA;MAAA;MACAC,UAAA;MAAA;MACAC,YAAA;MAAA;;MAEA;MACAC,UAAA;IACA;EACA;EACAC,QAAA;IACA;IACAC,aAAA;MACA,IAAAf,IAAA;MACA,SAAAG,UAAA,CAAAa,MAAA;QACAhB,IAAA,GAAAiB,IAAA,CAAAC,KAAA,CAAAD,IAAA,CAAAE,SAAA,MAAAjB,QAAA;MACA;QACAF,IAAA,GAAAiB,IAAA,CAAAC,KAAA,CAAAD,IAAA,CAAAE,SAAA,MAAAhB,UAAA;MACA;MACA,OAAAH,IAAA;IACA;IACA;IACAoB,QAAA;MACA,YAAAP,UAAA,CAAAQ,MAAA,CAAAC,IAAA,IAAAA,IAAA,CAAAC,OAAA;IACA;EACA;EACAC,OAAA;IACA;IACAC,iBAAAC,GAAA;MACA,KAAArB,QAAA,GAAAqB,GAAA;MACA,KAAAC,wBAAA;IACA;IACA;IACAC,oBAAAF,GAAA;MACA,KAAAtB,SAAA,GAAAsB,GAAA;MACA,KAAAC,wBAAA;IACA;IACA;IACAA,yB