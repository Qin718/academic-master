{"ast":null,"code":"export default {\n  name: \"SysLogin\",\n  data() {\n    return {\n      //集合参数\n      dataList: [],\n      //页面展示的数据集合\n\n      //页号参数\n      pageIndex: 1,\n      pageSize: 5,\n      pageSizes: [],\n      totalPage: 0,\n      begin: 0,\n      end: this.pageSize - 1\n    };\n  },\n  methods: {\n    //改变数组大小\n    sizeChangeHandle(val) {\n      this.pageSize = val;\n      this.getDataList();\n    },\n    //改变当前页号\n    CurrentChangeHandle(val) {\n      this.pageIndex = val;\n      this.getDataList();\n    },\n    //查询所有数据\n    getDataList() {\n      const pageInfo = this.$getPageInfo(this.pageSize, this.pageIndex);\n      this.$http.post(\"/login/getPageVo\", pageInfo).then(res => {\n        this.cutDataList(res);\n      });\n    },\n    //分页操作\n    cutDataList(res) {\n      const data = this.$cutPageDataList(res);\n      this.dataList = data.dataList;\n      this.totalPage = data.totalPage;\n    },\n    //初始化页号\n    setPageSize() {\n      this.pageSizes = this.$getPageSize();\n      this.pageSize = this.pageSizes[0];\n    }\n  },\n  mounted() {\n    this.setPageSize();\n    this.getDataList();\n  }\n};","map":{"version":3,"names":["name","data","dataList","pageIndex","pageSize","pageSizes","totalPage","begin","end","methods","sizeChangeHandle","val","getDataList","CurrentChangeHandle","pageInfo","$getPageInfo","$http","post","then","res","cutDataList","$cutPageDataList","setPageSize","$getPageSize","mounted"],"sources":["src/views/sys/SysLogin/index.vue"],"sourcesContent":["<template>\n  <el-card class=\"box-card\">\n    <div>\n      <!-- 角色数据表单 -->\n      <el-table :data=\"dataList\" border>\n        <el-table-column type=\"selection\" width=\"55\"></el-table-column>\n        <el-table-column label=\"编号\" prop=\"id\" width=\"100\">\n        </el-table-column>\n        <el-table-column label=\"用户账号\" prop=\"account\" width=\"180\">\n        </el-table-column>\n        <el-table-column label=\"用户名\" prop=\"username\" width=\"180\">\n        </el-table-column>\n        <el-table-column label=\"登录时间\" prop=\"time\" width=\"260\">\n        </el-table-column>\n        <el-table-column label=\"登录IP\" prop=\"ip\" width=\"180\">\n        </el-table-column>\n        <el-table-column label=\"登录设备\" prop=\"mobile\" width=\"180\">\n        </el-table-column>\n        <el-table-column label=\"登录IP\" prop=\"innerIp\" width=\"180\">\n        </el-table-column>\n      </el-table>\n      <!-- 页号 -->\n      <el-pagination\n        :current-page=\"pageIndex\"\n        :page-size=\"pageSize\"\n        :page-sizes=\"pageSizes\"\n        :total=\"totalPage\"\n        layout=\"total ,sizes,prev,pager,next,jumper\"\n        style=\"margin-top: 30px\"\n        @size-change=\"sizeChangeHandle\"\n        @current-change=\"CurrentChangeHandle\"\n      >\n      </el-pagination>\n    </div>\n  </el-card>\n</template>\n<script>\nexport default {\n  name: \"SysLogin\",\n  data() {\n    return {\n      //集合参数\n      dataList: [], //页面展示的数据集合\n\n      //页号参数\n      pageIndex: 1,\n      pageSize: 5,\n      pageSizes: [],\n      totalPage: 0,\n      begin: 0,\n      end: this.pageSize - 1,\n    };\n  },\n  methods: {\n    //改变数组大小\n    sizeChangeHandle(val) {\n      this.pageSize = val;\n      this.getDataList();\n    },\n    //改变当前页号\n    CurrentChangeHandle(val) {\n      this.pageIndex = val;\n      this.getDataList();\n    },\n\n    //查询所有数据\n    getDataList() {\n      const pageInfo = this.$getPageInfo(this.pageSize, this.pageIndex)\n      this.$http.post(\"/login/getPageVo\", pageInfo).then((res) => {\n        this.cutDataList(res);\n      });\n    },\n\n    //分页操作\n    cutDataList(res) {\n      const data = this.$cutPageDataList(res)\n      this.dataList = data.dataList\n      this.totalPage = data.totalPage\n    },\n\n    //初始化页号\n    setPageSize() {\n      this.pageSizes = this.$getPageSize()\n      this.pageSize = this.pageSizes[0]\n    }\n  },\n  mounted() {\n\t  this.setPageSize();\n    this.getDataList();\n  },\n};\n</script>\n"],"mappings":"AAqCA;EACAA,IAAA;EACAC,KAAA;IACA;MACA;MACAC,QAAA;MAAA;;MAEA;MACAC,SAAA;MACAC,QAAA;MACAC,SAAA;MACAC,SAAA;MACAC,KAAA;MACAC,GAAA,OAAAJ,QAAA;IACA;EACA;EACAK,OAAA;IACA;IACAC,iBAAAC,GAAA;MACA,KAAAP,QAAA,GAAAO,GAAA;MACA,KAAAC,WAAA;IACA;IACA;IACAC,oBAAAF,GAAA;MACA,KAAAR,SAAA,GAAAQ,GAAA;MACA,KAAAC,WAAA;IACA;IAEA;IACAA,YAAA;MACA,MAAAE,QAAA,QAAAC,YAAA,MAAAX,QAAA,OAAAD,SAAA;MACA,KAAAa,KAAA,CAAAC,IAAA,qBAAAH,QAAA,EAAAI,IAAA,CAAAC,GAAA;QACA,KAAAC,WAAA,CAAAD,GAAA;MACA;IACA;IAEA;IACAC,YAAAD,GAAA;MACA,MAAAlB,IAAA,QAAAoB,gBAAA,CAAAF,GAAA;MACA,KAAAjB,QAAA,GAAAD,IAAA,CAAAC,QAAA;MACA,KAAAI,SAAA,GAAAL,IAAA,CAAAK,SAAA;IACA;IAEA;IACAgB,YAAA;MACA,KAAAjB,SAAA,QAAAkB,YAAA;MACA,KAAAnB,QAAA,QAAAC,SAAA;IACA;EACA;EACAmB,QAAA;IACA,KAAAF,WAAA;IACA,KAAAV,WAAA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}