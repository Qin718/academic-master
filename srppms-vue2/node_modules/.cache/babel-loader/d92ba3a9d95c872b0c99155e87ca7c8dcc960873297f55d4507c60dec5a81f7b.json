s([\"sidebarMenu\",\"isCollapse\"]),\n  },\n};\n</script>\n\n<style lang=\"less\" scoped>\n.el-menu {\n  min-height: 200vh;\n  height: 300%;\n  border-right: none;\n\n  h3 {\n    color: white;\n    text-align: center;\n    line-height: 48px;\n    font-size: 16px;\n    font-weight: 400;\n    padding: 0 20px;\n  }\n}\n</style>\n"],"mappings":";AA2BA,SAAAA,UAAA,EAAAC,QAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,QAAA;IACA;EACA;EACAC,OAAA;IACAC,UAAAC,IAAA;MACA,SAAAC,MAAA,CAAAC,IAAA,KAAAF,IAAA,CAAAG,GAAA;QACA;QACA,KAAAC,OAAA,CAAAC,IAAA,CAAAL,IAAA,CAAAG,GAAA;MACA;IACA;EACA;EACAG,QAAA;IACA,GAAAZ,QAAA;IACA,GAAAD,UAAA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}