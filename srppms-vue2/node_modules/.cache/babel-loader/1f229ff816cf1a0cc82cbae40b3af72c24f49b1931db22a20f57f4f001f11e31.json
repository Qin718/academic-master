{"ast":null,"code":"import ThemePicker from '@/components/utils/ThemePicker';\nimport cache from \"@/method/cache\";\nexport default {\n  components: {\n    ThemePicker\n  },\n  data() {\n    return {\n      theme: this.$store.state.settings.theme,\n      sideTheme: this.$store.state.settings.sideTheme,\n      imageDark: require(\"@/assets/images/dark.svg\"),\n      imageLight: require(\"@/assets/images/light.svg\")\n    };\n  },\n  computed: {\n    visible: {\n      get() {\n        return this.$store.state.settings.showSettings;\n      }\n    },\n    topNav: {\n      get() {\n        return this.$store.state.settings.topNav;\n      },\n      set(val) {\n        this.$store.dispatch('settings/changeSetting', {\n          key: 'topNav',\n          value: val\n        });\n      }\n    },\n    tagsView: {\n      get() {\n        return this.$store.state.settings.tagsView;\n      },\n      set(val) {\n        this.$store.dispatch('settings/changeSetting', {\n          key: 'tagsView',\n          value: val\n        });\n      }\n    },\n    sidebarLogo: {\n      get() {\n        return this.$store.state.settings.sidebarLogo;\n      },\n      set(val) {\n        this.$store.dispatch('settings/changeSetting', {\n          key: 'sidebarLogo',\n          value: val\n        });\n      }\n    },\n    dynamicTitle: {\n      get() {\n        return this.$store.state.settings.dynamicTitle;\n      },\n      set(val) {\n        this.$store.dispatch('settings/changeSetting', {\n          key: 'dynamicTitle',\n          value: val\n        });\n      }\n    }\n  },\n  methods: {\n    themeChange(val) {\n      this.$store.dispatch('settings/changeSetting', {\n        key: 'theme',\n        value: val\n      });\n      this.theme = val;\n    },\n    handleTheme(val) {\n      this.$store.dispatch('settings/changeSetting', {\n        key: 'sideTheme',\n        value: val\n      });\n      this.sideTheme = val;\n    },\n    saveSetting() {\n      this.$GlobalLoading(true, {\n        text: \"正在保存到本地，请稍候...\"\n      });\n      cache.local.set(\"ThemeSetting\", `{\n            \"topNav\":${this.topNav},\n            \"tagsView\":${this.tagsView},\n            \"sidebarLogo\":${this.sidebarLogo},\n            \"dynamicTitle\":${this.dynamicTitle},\n            \"sideTheme\":\"${this.sideTheme}\",\n            \"theme\":\"${this.theme}\"\n          }`);\n      setTimeout(this.$GlobalLoading(false, null), 1000);\n    },\n    resetSetting() {\n      this.$GlobalLoading(true, {\n        text: \"正在清除设置缓存并刷新，请稍候...\"\n      });\n      cache.local.remove(\"ThemeSetting\");\n      setTimeout(\"window.location.reload()\", 1000);\n    }\n  }\n};","map":{"version":3,"names":["ThemePicker","cache","components","data","theme","$store","state","settings","sideTheme","imageDark","require","imageLight","computed","visible","get","showSettings","topNav","set","val","dispatch","key","value","tagsView","sidebarLogo","dynamicTitle","methods","themeChange","handleTheme","saveSetting","$GlobalLoading","text","local","setTimeout","resetSetting","remove"],"sources":["src/components/utils/RightPanel/settings/index.vue"],"sourcesContent":["<template>\n  <el-drawer :append-to-body=\"true\" :show-close=\"false\" :visible=\"visible\" :with-header=\"false\" size=\"280px\">\n    <div class=\"drawer-container\">\n      <div>\n        <div class=\"setting-drawer-content\">\n          <div class=\"setting-drawer-title\">\n            <h3 class=\"drawer-title\">主题风格设置</h3>\n          </div>\n          <div class=\"setting-drawer-block-checkbox\">\n            <div class=\"setting-drawer-block-checkbox-item\" @click=\"handleTheme('theme-dark')\">\n              <img :src=\"imageDark\" alt=\"dark\">\n              <div v-if=\"sideTheme === 'theme-dark'\" class=\"setting-drawer-block-checkbox-selectIcon\"\n                   style=\"display: block;\">\n                <i aria-label=\"图标: check\">\n                  <svg :fill=\"theme\" aria-hidden=\"true\" class=\"\" data-icon=\"check\"