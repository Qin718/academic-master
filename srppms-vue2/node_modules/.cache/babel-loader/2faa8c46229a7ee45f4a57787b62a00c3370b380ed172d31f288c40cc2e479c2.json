{"ast":null,"code":"import pieChartLeft from '@/components/charts/ItemCount/pieChartLeft';\nimport pieChartRight from '@/components/charts/ItemCount/pieChartRight';\nimport lineChart from '@/components/charts/ItemCount/lineChart';\nexport default {\n  components: {\n    pieChartLeft,\n    pieChartRight,\n    lineChart\n  },\n  name: \"ItemCount\",\n  data() {\n    return {\n      like: true,\n      like2: true,\n      //去年\n      value1_1: 0,\n      value1_2: 0,\n      value1_3: 0,\n      value1_4: \"\",\n      value1_5: 0,\n      title1: \"去年新增项目\",\n      title1_2: \"去年成功项目\",\n      title1_3: \"去年申请资金\",\n      title1_4: \"去年最受欢迎的项目\",\n      title1_5: \"获赞数量\",\n      value2_1: 0,\n      value2_2: 0,\n      value2_3: 0,\n      value2_4: \"\",\n      value2_5: 0,\n      title2: \"今年新增项目\",\n      title2_2: \"今年成功项目\",\n      title2_3: \"今年申请资金\",\n      title2_4: \"今年最受欢迎的项目\",\n      title2_5: \"获赞数量\",\n      title: {\n        text: \"今年项目图片\"\n      }\n    };\n  },\n  methods: {\n    //今年\n    getThisYear() {\n      this.$http.post(\"/project/getList/thisYear\").then(res => {\n        if (res !== null) {\n          this.value2_1 = res[\"newAdd\"];\n          this.value2_2 = res[\"success\"];\n          this.value2_3 = res[\"money\"];\n          this.value2_4 = res[\"itemName\"];\n          this.value2_5 = res[\"scoreNumber\"];\n        }\n      });\n    },\n    //去年\n    getLastYear() {\n      this.$http.post(\"/project/getList/lastYear\").then(res => {\n        if (res !== null) {\n          this.value1_1 = res[\"newAdd\"];\n          this.value1_2 = res[\"success\"];\n          this.value1_3 = res[\"money\"];\n          this.value1_4 = res[\"itemName\"];\n          this.value1_5 = res[\"scoreNumber\"];\n        }\n      });\n    }\n  },\n  mounted() {\n    this.getThisYear();\n    this.getLastYear();\n  }\n};","map":{"version":3,"names":["pieChartLeft","pieChartRight","lineChart","components","name","data","like","like2","value1_1","value1_2","value1_3","value1_4","value1_5","title1","title1_2","title1_3","title1_4","title1_5","value2_1","value2_2","value2_3","value2_4","value2_5","title2","title2_2","title2_3","title2_4","title2_5","title","text","methods","getThisYear","$http","post","then","res","getLastYear","mounted"],"sources":["src/views/count/ItemCount/index.vue"],"sourcesContent":["<template>\n  <div style=\"width: 100%\">\n    <!-- 去年 -->\n    <el-card>\n      <el-row :gutter=\"20\">\n        <!-- 去年新增项目 -->\n        <el-col :span=\"4\">\n          <div>\n            <el-statistic\n              :title=\"title1\"\n              :value=\"value1_1\"\n              decimal-separator=\".\"\n              group-separator=\",\"\n            >\n            </el-statistic>\n          </div>\n        </el-col>\n        <!-- 去年成功项目 -->\n        <el-col :span=\"4\">\n          <div>\n            <el-statistic :title=\"title1_2\" :value=\"value1_2\"></el-statistic>\n          </div>\n        </el-col>\n        <!-- 去年申请资金 -->\n        <el-col :span=\"5\">\n          <div>\n            <el-statistic\n              :precision=\"2\"\n              :title=\"title1_3\"\n              :value=\"value1_3\"\n              group-separator=\",\"\n            >\n              <template slot=\"prefix\">\n                <i class=\"el-icon-s-flag\" style=\"color: red\"></i>\n              </template>\n              <template slot=\"suffix\">\n                <i class=\"el-icon-s-flag\" style=\"color: blue\"></i>\n              </template>\n            </el-statistic>\n          </div>\n        </el-col>\n        <!-- 去年最受欢迎的项目 -->\n        <el-col :span=\"6\">\n          <div>\n            <el-statistic :title=\"title1_4\" :value=\"value1_4\">\n              <template slot=\"prefix\">\n                <i class=\"el-icon-s-flag\" style=\"color: red\"></i>\n              </template>\n              <template slot=\"formatter\">\n                {{ this.value1_4 }}\n              </template>\n              <template slot=\"suffix\">\n                <i class=\"el-icon-s-flag\" style=\"color: blue\"></i>\n              </template>\n            </el-statistic>\n          </div>\n        </el-col>\n        <!-- 获赞数量 -->\n        <el-col :span=\"3\">\n          <div>\n            <el-statistic :title=\"title1_5\" :value=\"value1_5\">\n              <template slot=\"suffix\">\n                <span class=\"like\" @click=\"like = !like\">\n                  <i\n                    v-show=\"!!like\"\n                    class=\"el-icon-star-on\"\n                    style=\"color: red\"\n                  ></i>\n                  <i v-show=\"!like\" class=\"el-icon-star-off\"></i>\n                </span>\n              </template>\n            </el-statistic>\n          </div>\n        </el-col>\n      </el-row>\n    </el-card>\n    <!-- 今年 -->\n    <el-card style=\"margin-top: 10px;\">\n      <el-row :gutter=\"20\">\n        <!-- 今年新增项目 -->\n        <el-col :span=\"4\">\n          <div>\n            <el-statistic\n              :title=\"title2\"\n              :value=\"value2_1\"\n              decimal-separator=\".\"\n              group-separator=\",\"\n            >\n            </el-statistic>\n          </div>\n        </el-col>\n        <!-- 今年成功项目 -->\n        <el-col :span=\"4\">\n          <div>\n            <el-statistic :title=\"title2_2\" :value=\"value2_2\"></el-statistic>\n          </div>\n        </el-col>\n        <!-- 今年申请资金 -->\n        <el-col :span=\"5\">\n          <div>\n            <el-statistic\n              :precision=\"2\"\n              :title=\"title2_3\"\n              :value=\"value2_3\"\n              group-separator=\",\"\n            >\n              <template slot=\"prefix\">\n                <i class=\"el-icon-s-flag\" style=\"color: red\"></i>\n              </template>\n              <template slot=\"suffix\">\n                <i class=\"el-icon-s-flag\" style=\"color: blue\"></i>\n              </template>\n            </el-statistic>\n          </div>\n        </el-col>\n        <!-- 今年最受欢迎的项目 -->\n        <el-col :span=\"6\">\n          <div>\n            <el-statistic :title=\"title2_4\" :value=\"value2_4\">\n              <template slot=\"prefix\">\n                <i class=\"el-icon-s-flag\" style=\"color: red\"></i>\n              </template>\n              <template slot=\"formatter\">\n                {{ this.value2_4 }}\n              </template>\n              <template slot=\"suffix\">\n                <i class=\"el-icon-s-flag\" style=\"color: blue\"></i>\n              </template>\n            </el-statistic>\n          </div>\n        </el-col>\n        <!-- 获赞数量 -->\n        <el-col :span=\"3\">\n          <div>\n            <el-statistic :title=\"title2_5\" :value=\"value2_5\">\n              <template slot=\"suffix\">\n                <span class=\"like2\" @click=\"like2 = !like2\">\n                  <i\n                    v-show=\"!!like2\"\n                    class=\"el-icon-star-on\"\n                    style=\"color: red\"\n                  ></i>\n                  <i v-show=\"!like2\" class=\"el-icon-star-off\"></i>\n                </span>\n              </template>\n            </el-statistic>\n          </div>\n        </el-col>\n      </el-row>\n    </el-card>\n    <!-- ____________________________________________________________ -->\n    <!-- 图表 -->\n    <el-card style=\"margin-top: 10px;\">\n      <!-- 饼状图-->\n      <div style=\"width: 1500px; margin-left: 10px; height: 450px\">\n        <el-card style=\"width:45%; height:100%; float: left\">\n          <pieChartLeft/>\n        </el-card>\n        <el-card style=\"width:45%; padding-left: 30px; height:100%;\">\n          <pieChartRight/>\n        </el-card>\n      </div>\n    </el-card>\n    <!-- 折线图-->\n    <el-card style=\"margin-top: 10px; float: left\">\n      <div style=\"width: 1380px;\">\n        <lineChart/>\n      </div>\n    </el-card>\n  </div>\n</template>\n<script>\nimport pieChartLeft from '@/components/charts/ItemCount/pieChartLeft';\nimport pieChartRight from '@/components/charts/ItemCount/pieChartRight';\nimport lineChart from '@/components/charts/ItemCount/lineChart';\n\nexport default {\n  components: {pieChartLeft, pieChartRight, lineChart},\n  name: \"ItemCount\",\n  data() {\n    return {\n      like: true,\n      like2: true,\n      //去年\n      value1_1: 0,\n      value1_2: 0,\n      value1_3: 0,\n      value1_4: \"\",\n      value1_5: 0,\n      title1: \"去年新增项目\",\n      title1_2: \"去年成功项目\",\n      title1_3: \"去年申请资金\",\n      title1_4: \"去年最受欢迎的项目\",\n      title1_5: \"获赞数量\",\n\n      value2_1: 0,\n      value2_2: 0,\n      value2_3: 0,\n      value2_4: \"\",\n      value2_5: 0,\n      title2: \"今年新增项目\",\n      title2_2: \"今年成功项目\",\n      title2_3: \"今年申请资金\",\n      title2_4: \"今年最受欢迎的项目\",\n      title2_5: \"获赞数量\",\n      title: {\n        text: \"今年项目图片\",\n      },\n    };\n  },\n  methods: {\n    //今年\n    getThisYear() {\n      this.$http.post(\"/project/getList/thisYear\").then((res) => {\n\t      if (res !== null) {\n\t\t      this.value2_1 = res[\"newAdd\"];\n\t\t      this.value2_2 = res[\"success\"];\n\t\t      this.value2_3 = res[\"money\"];\n\t\t      this.value2_4 = res[\"itemName\"];\n\t\t      this.value2_5 = res[\"scoreNumber\"];\n\t      }\n      });\n    },\n    //去年\n    getLastYear() {\n      this.$http.post(\"/project/getList/lastYear\").then((res) => {\n\t      if (res !== null) {\n\t\t      this.value1_1 = res[\"newAdd\"];\n\t\t      this.value1_2 = res[\"success\"];\n\t\t      this.value1_3 = res[\"money\"];\n\t\t      this.value1_4 = res[\"itemName\"];\n\t\t      this.value1_5 = res[\"scoreNumber\"];\n\t      }\n      });\n    },\n  },\n  mounted() {\n    this.getThisYear();\n    this.getLastYear();\n  },\n};\n</script>\n<style lang=\"less\">\n.like {\n  cursor: pointer;\n  font-size: 25px;\n  display: inline-block;\n}\n\n.like2 {\n  cursor: pointer;\n  font-size: 25px;\n  display: inline-block;\n}\n\n.container {\n  width: 500px;\n  height: 300px;\n}\n\n//.verticalBar {\n//  width: 1px;\n//  height: 400px;\n//  background: blue;\n//  display: inline-block;\n//  vertical-align: top;\n//}\n</style>\n"],"mappings":"AA4KA,OAAAA,YAAA;AACA,OAAAC,aAAA;AACA,OAAAC,SAAA;AAEA;EACAC,UAAA;IAAAH,YAAA;IAAAC,aAAA;IAAAC;EAAA;EACAE,IAAA;EACAC,KAAA;IACA;MACAC,IAAA;MACAC,KAAA;MACA;MACAC,QAAA;MACAC,QAAA;MACAC,QAAA;MACAC,QAAA;MACAC,QAAA;MACAC,MAAA;MACAC,QAAA;MACAC,QAAA;MACAC,QAAA;MACAC,QAAA;MAEAC,QAAA;MACAC,QAAA;MACAC,QAAA;MACAC,QAAA;MACAC,QAAA;MACAC,MAAA;MACAC,QAAA;MACAC,QAAA;MACAC,QAAA;MACAC,QAAA;MACAC,KAAA;QACAC,IAAA;MACA;IACA;EACA;EACAC,OAAA;IACA;IACAC,YAAA;MACA,KAAAC,KAAA,CAAAC,IAAA,8BAAAC,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA;UACA,KAAAjB,QAAA,GAAAiB,GAAA;UACA,KAAAhB,QAAA,GAAAgB,GAAA;UACA,KAAAf,QAAA,GAAAe,GAAA;UACA,KAAAd,QAAA,GAAAc,GAAA;UACA,KAAAb,QAAA,GAAAa,GAAA;QACA;MACA;IACA;IACA;IACAC,YAAA;MACA,KAAAJ,KAAA,CAAAC,IAAA,8BAAAC,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA;UACA,KAAA3B,QAAA,GAAA2B,GAAA;UACA,KAAA1B,QAAA,GAAA0B,GAAA;UACA,KAAAzB,QAAA,GAAAyB,GAAA;UACA,KAAAxB,QAAA,GAAAwB,GAAA;UACA,KAAAvB,QAAA,GAAAuB,GAAA;QACA;MACA;IACA;EACA;EACAE,QAAA;IACA,KAAAN,WAAA;IACA,KAAAK,WAAA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}