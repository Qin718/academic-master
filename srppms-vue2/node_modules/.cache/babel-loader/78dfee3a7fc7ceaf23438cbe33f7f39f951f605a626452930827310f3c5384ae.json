{"ast":null,"code":"import logoImg from '@/assets/logo/logo.png';\nimport { title } from \"@/settings\";\nimport { mapGetters } from \"vuex\";\nexport default {\n  name: 'logo',\n  data() {\n    return {\n      title: title,\n      logo: logoImg\n    };\n  },\n  computed: {\n    ...mapGetters([\"isCollapse\"]),\n    sideTheme() {\n      return this.$store.state.settings.sideTheme;\n    }\n  }\n};","map":{"version":3,"names":["logoImg","title","mapGetters","name","data","logo","computed","sideTheme","$store","state","settings"],"sources":["src/components/Aside/Logo/index.vue"],"sourcesContent":["<template>\n  <div :style=\"{ backgroundColor: sideTheme === 'theme-dark' ? `#304156` : `#ffffff` }\"\n       class=\"container\">\n    <transition>\n      <router-link class=\"link\" to=\"/Index\">\n        <img :src=\"logo\" alt=\"\" class=\"logo\">\n        <!-- logo 文字 -->\n        <h1 v-if=\"!isCollapse\" :style=\"{ color: sideTheme === 'theme-dark' ? `#ffffff` : `#001529` }\"\n            class=\"title\">\n          {{ title }}\n        </h1>\n      </router-link>\n    </transition>\n  </div>\n</template>\n\n<script>\nimport logoImg from '@/assets/logo/logo.png'\nimport {title} from \"@/settings\";\nimport {mapGetters} from \"vuex\";\n\nexport default {\n  name: 'logo',\n  data() {\n    return {\n      title: title,\n      logo: logoImg\n    }\n  },\n  computed: {\n    ...mapGetters([\"isCollapse\"]),\n    sideTheme() {\n      return this.$store.state.settings.sideTheme\n    },\n  }\n}\n</script>\n\n<style lang=\"less\" scoped>\n.container {\n  position: relative;\n  width: 100%;\n  height: 50px;\n  line-height: 50px;\n  text-align: center;\n  overflow: hidden;\n\n  & .link {\n    height: 100%;\n    width: 100%;\n\n    & .logo {\n      width: 32px;\n      height: 32px;\n      vertical-align: middle;\n      margin-right: 12px;\n    }\n\n    & .title {\n      display: inline-block;\n      margin: 0;\n      font-weight: 600;\n      line-height: 50px;\n      font-size: 14px;\n      font-family: Avenir, Helvetica Neue, Arial, Helvetica, sans-serif;\n      vertical-align: middle;\n    }\n  }\n}\n</style>\n"],"mappings":"AAiBA,OAAAA,OAAA;AACA,SAAAC,KAAA;AACA,SAAAC,UAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAH,KAAA,EAAAA,KAAA;MACAI,IAAA,EAAAL;IACA;EACA;EACAM,QAAA;IACA,GAAAJ,UAAA;IACAK,UAAA;MACA,YAAAC,MAAA,CAAAC,KAAA,CAAAC,QAAA,CAAAH,SAAA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}