{"ast":null,"code":"import Aside from \"../Aside\";\nimport Header from \"../Header\";\nimport CommonTab from \"../CommonTab\";\nimport Socket from \"../WebSocket\";\nimport Top from \"../Top\";\nimport Footer from \"../Footer\";\nimport RightPanel from \"../utils/RightPanel\";\nimport { mapGetters } from \"vuex\";\nimport ResizeMixin from \"@/method/ResizeHandler\";\nimport { message } from \"@/method/message\";\nexport default {\n  name: \"Home\",\n  data() {\n    return {\n      onLine: navigator.onLine\n    };\n  },\n  components: {\n    Aside,\n    Header,\n    CommonTab,\n    Socket,\n    Top,\n    Footer,\n    RightPanel\n  },\n  methods: {\n    //全局参数\n    setGlobalConfig() {\n      this.$http.post(\"/config/getMap\").then(res => {\n        this.$setGlobalConfig(res);\n      });\n    },\n    //检查网络\n    checkOnline(online) {\n      if (online) {\n        this.$GlobalLoading(false, {});\n      } else {\n        this.$GlobalLoading(true, {\n          text: \"网络正在加载中,请稍后....\"\n        });\n        setTimeout(() => {\n          this.$GlobalLoading(false, {});\n          message.info(\"网络加载失败，请检查网络！\");\n          this.onLine = true;\n        }, 3000);\n      }\n      window.addEventListener('offline', () => {\n        this.checkOnline(navigator.onLine);\n      });\n      window.addEventListener('online', () => {\n        message.success(\"网络连接成功\");\n        this.checkOnline(navigator.onLine);\n      });\n    }\n  },\n  mounted() {\n    this.setGlobalConfig();\n    this.checkOnline(this.onLine);\n  },\n  mixins: [ResizeMixin],\n  computed: {\n    ...mapGetters([\"isCollapse\", \"needTagsView\"])\n  },\n  beforeDestroy() {\n    window.removeEventListener('online', this.checkOnline);\n    window.removeEventListener('offline', this.checkOnline);\n  }\n};","map":{"version":3,"names":["Aside","Header","CommonTab","Socket","Top","Footer","RightPanel","mapGetters","ResizeMixin","message","name","data","onLine","navigator","components","methods","setGlobalConfig","$http","post","then","res","$setGlobalConfig","checkOnline","online","$GlobalLoading","text","setTimeout","info","window","addEventListener","success","mounted","mixins","computed","beforeDestroy","removeEventListener"],"sources":["src/components/Home/index.vue"],"sourcesContent":["<template>\n  <div class=\"hello\">\n    <el-container>\n      <el-aside :style=\"{ width : isCollapse ? `auto` : `10%`}\">\n        <!-- 左侧菜单 -->\n        <Aside/>\n      </el-aside>\n      <el-container>\n        <el-header>\n          <!-- 头部 -->\n          <Header/>\n        </el-header>\n        <!-- 方形面包屑 -->\n        <common-tab v-if=\"needTagsView\"/>\n        <el-main>\n          <div class=\"loading-area\" style=\"width: 100%;height: 100%\">\n            <transition mode=\"out-in\" name=\"fade-transform\">\n            <!-- 路由出口 -->\n            <router-view/>\n            </transition>\n          </div>\n          <!-- 右侧面板 -->\n          <right-panel/>\n          <!-- 回到顶部图标 -->\n          <Top/>\n          <!-- Websocket -->\n          <Socket/>\n        </el-main>\n      </el-container>\n    </el-container>\n    <el-footer>\n      <!-- 底部 -->\n      <Footer/>\n    </el-footer>\n  </div>\n</template>\n\n<script>\nimport Aside from \"../Aside\";\nimport Header from \"../Header\";\nimport CommonTab from \"../CommonTab\";\nimport Socket from \"../WebSocket\";\nimport Top from \"../Top\";\nimport Footer from \"../Footer\";\nimport RightPanel from \"../utils/RightPanel\";\nimport {mapGetters} from \"vuex\";\nimport ResizeMixin from \"@/method/ResizeHandler\"\nimport {message} from \"@/method/message\";\n\nexport default {\n  name: \"Home\",\n  data(){\n    return{\n      onLine: navigator.onLine\n    }\n  },\n  components: {\n    Aside,\n    Header,\n    CommonTab,\n    Socket,\n    Top,\n    Footer,\n    RightPanel,\n  },\n  methods: {\n    //全局参数\n    setGlobalConfig() {\n      this.$http.post(\"/config/getMap\").then((res) => {\n        this.$setGlobalConfig(res)\n      });\n    },\n    //检查网络\n    checkOnline(online){\n      if (online){\n        this.$GlobalLoading(false,{})\n      }else {\n        this.$GlobalLoading(true,{text:\"网络正在加载中,请稍后....\"})\n        setTimeout(()=>{\n          this.$GlobalLoading(false,{})\n          message.info(\"网络加载失败，请检查网络！\");\n          this.onLine = true;\n        },3000)\n      }\n      window.addEventListener('offline', () => {\n        this.checkOnline(navigator.onLine);\n      })\n      window.addEventListener('online', () => {\n        message.success(\"网络连接成功\");\n        this.checkOnline(navigator.onLine);\n      })\n    },\n  },\n  mounted() {\n    this.setGlobalConfig();\n    this.checkOnline(this.onLine);\n  },\n  mixins: [ResizeMixin],\n  computed: {\n    ...mapGetters([\"isCollapse\",\"needTagsView\"]),\n  },\n  beforeDestroy() {\n    window.removeEventListener('online', this.checkOnline);\n    window.removeEventListener('offline', this.checkOnline);\n  },\n};\n</script>\n\n<!-- Add \"scoped\" attribute to limit CSS to this component only -->\n<style lang=\"less\" scoped>\n/** 去除左侧菜单滚动条 */\n.el-aside::-webkit-scrollbar {\n  display: none;\n}\n\n/** 去除el-main滚动条 */\n.el-main::-webkit-scrollbar {\n  display: none;\n}\n\n/* fade-transform */\n.fade-transform--move,\n.fade-transform-leave-active,\n.fade-transform-enter-active {\n  transition: all .5s;\n}\n\n.fade-transform-enter {\n  opacity: 0;\n  transform: translateX(-30px);\n}\n\n.fade-transform-leave-to {\n  opacity: 0;\n  transform: translateX(30px);\n}\n\n</style>\n"],"mappings":"AAsCA,OAAAA,KAAA;AACA,OAAAC,MAAA;AACA,OAAAC,SAAA;AACA,OAAAC,MAAA;AACA,OAAAC,GAAA;AACA,OAAAC,MAAA;AACA,OAAAC,UAAA;AACA,SAAAC,UAAA;AACA,OAAAC,WAAA;AACA,SAAAC,OAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,MAAA,EAAAC,SAAA,CAAAD;IACA;EACA;EACAE,UAAA;IACAd,KAAA;IACAC,MAAA;IACAC,SAAA;IACAC,MAAA;IACAC,GAAA;IACAC,MAAA;IACAC;EACA;EACAS,OAAA;IACA;IACAC,gBAAA;MACA,KAAAC,KAAA,CAAAC,IAAA,mBAAAC,IAAA,CAAAC,GAAA;QACA,KAAAC,gBAAA,CAAAD,GAAA;MACA;IACA;IACA;IACAE,YAAAC,MAAA;MACA,IAAAA,MAAA;QACA,KAAAC,cAAA;MACA;QACA,KAAAA,cAAA;UAAAC,IAAA;QAAA;QACAC,UAAA;UACA,KAAAF,cAAA;UACAf,OAAA,CAAAkB,IAAA;UACA,KAAAf,MAAA;QACA;MACA;MACAgB,MAAA,CAAAC,gBAAA;QACA,KAAAP,WAAA,CAAAT,SAAA,CAAAD,MAAA;MACA;MACAgB,MAAA,CAAAC,gBAAA;QACApB,OAAA,CAAAqB,OAAA;QACA,KAAAR,WAAA,CAAAT,SAAA,CAAAD,MAAA;MACA;IACA;EACA;EACAmB,QAAA;IACA,KAAAf,eAAA;IACA,KAAAM,WAAA,MAAAV,MAAA;EACA;EACAoB,MAAA,GAAAxB,WAAA;EACAyB,QAAA;IACA,GAAA1B,UAAA;EACA;EACA2B,cAAA;IACAN,MAAA,CAAAO,mBAAA,gBAAAb,WAAA;IACAM,MAAA,CAAAO,mBAAA,iBAAAb,WAAA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}