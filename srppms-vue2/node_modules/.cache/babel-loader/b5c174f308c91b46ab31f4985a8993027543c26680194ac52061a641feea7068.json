{"ast":null,"code":"export default {\n  name: \"SysUserOnline\",\n  data() {\n    return {\n      //集合参数\n      dataList: [],\n      //页面展示的数据集合\n\n      //页号参数\n      pageIndex: 1,\n      pageSize: 5,\n      pageSizes: [],\n      totalPage: 0,\n      begin: 0,\n      end: this.pageSize - 1\n    };\n  },\n  methods: {\n    //改变数组大小\n    sizeChangeHandle(val) {\n      this.pageSize = val;\n      this.getDataList();\n    },\n    //改变当前页号\n    CurrentChangeHandle(val) {\n      this.pageIndex = val;\n      this.getDataList();\n    },\n    //分页操作\n    cutDataList(res) {\n      const data = this.$cutPageDataList(res);\n      this.dataList = data.dataList;\n      this.totalPage = data.totalPage;\n    },\n    //查询所有数据\n    getDataList() {\n      const pageInfo = this.$getPageInfo(this.pageSize, this.pageIndex);\n      this.$http.post(\"/user/Online/getList\", pageInfo).then(res => {\n        this.cutDataList(res);\n      });\n    },\n    //强退用户\n    forcedRetreat(item) {\n      const pageInfo = this.$getPageInfo(this.pageSize, this.pageIndex);\n      this.$http.post(\"/login/forcedOut/\" + item.account, pageInfo).then(res => {\n        this.cutDataList(res);\n      });\n    },\n    //初始化页号\n    setPageSize() {\n      this.pageSizes = this.$getPageSize();\n      this.pageSize = this.pageSizes[0];\n    }\n  },\n  mounted() {\n    this.setPageSize();\n    this.getDataList();\n  }\n};","map":{"version":3,"names":["name","data","dataList","pageIndex","pageSize","pageSizes","totalPage","begin","end","methods","sizeChangeHandle","val","getDataList","CurrentChangeHandle","cutDataList","res","$cutPageDataList","pageInfo","$getPageInfo","$http","post","then","forcedRetreat","item","account","setPageSize","$getPageSize","mounted"],"sources":["src/views/sys/SysUserOnline/index.vue"],"sourcesContent":["<template>\n  <el-card class=\"box-card\">\n    <div>\n      <!-- 角色数据表单 -->\n      <el-table ref=\"multipleTable\" :data=\"dataList\" border>\n        <el-table-column label=\"用户账号\" prop=\"account\" width=\"110\">\n        </el-table-column>\n        <el-table-column label=\"用户名\" prop=\"username\" width=\"110\">\n        </el-table-column>\n        <el-table-column label=\"登录设备\" prop=\"mobile\" width=\"80\">\n        </el-table-column>\n        <el-table-column label=\"登录过期时间\" prop=\"loginTimeout\" width=\"150\">\n        </el-table-column>\n        <el-table-column label=\"token\" prop=\"token\" width=\"350\">\n        </el-table-column>\n        <el-table-column label=\"操作\">\n          <template v-slot=\"scope\">\n            <el-button @click=\"forcedRetreat(scope.row)\" size=\"mini\" type=\"warning\">\n              强退\n            </el-button>\n          </template>\n        </el-table-column>\n      </el-table>\n      <!-- 页号 -->\n      <el-pagination\n        :current-page=\"pageIndex\"\n        :page-size=\"pageSize\"\n        :page-sizes=\"pageSizes\"\n        :total=\"totalPage\"\n        layout=\"total ,sizes,prev,pager,next,jumper\"\n        style=\"margin-top: 30px\"\n        @size-change=\"sizeChangeHandle\"\n        @current-change=\"CurrentChangeHandle\"\n      >\n      </el-pagination>\n    </div>\n  </el-card>\n</template>\n<script>\nexport default {\n  name: \"SysUserOnline\",\n  data() {\n    return {\n      //集合参数\n      dataList: [], //页面展示的数据集合\n\n      //页号参数\n      pageIndex: 1,\n      pageSize: 5,\n      pageSizes: [],\n      totalPage: 0,\n      begin: 0,\n      end: this.pageSize - 1,\n    };\n  },\n  methods: {\n    //改变数组大小\n    sizeChangeHandle(val) {\n      this.pageSize = val;\n      this.getDataList();\n    },\n    //改变当前页号\n    CurrentChangeHandle(val) {\n      this.pageIndex = val;\n      this.getDataList();\n    },\n\n    //分页操作\n    cutDataList(res) {\n      const data = this.$cutPageDataList(res)\n      this.dataList = data.dataList\n      this.totalPage = data.totalPage\n    },\n\n    //查询所有数据\n    getDataList() {\n      const pageInfo = this.$getPageInfo(this.pageSize, this.pageIndex)\n      this.$http.post(\"/user/Online/getList\", pageInfo).then((res) => {\n        this.cutDataList(res);\n      });\n    },\n\n    //强退用户\n    forcedRetreat(item) {\n      const pageInfo = this.$getPageInfo(this.pageSize, this.pageIndex)\n      this.$http.post(\"/login/forcedOut/\" + item.account, pageInfo).then((res) => {\n        this.cutDataList(res);\n      });\n    },\n\n    //初始化页号\n    setPageSize() {\n      this.pageSizes = this.$getPageSize()\n      this.pageSize = this.pageSizes[0]\n    }\n  },\n  mounted() {\n\t  this.setPageSize();\n    this.getDataList();\n  },\n};\n</script>\n"],"mappings":"AAuCA;EACAA,IAAA;EACAC,KAAA;IACA;MACA;MACAC,QAAA;MAAA;;MAEA;MACAC,SAAA;MACAC,QAAA;MACAC,SAAA;MACAC,SAAA;MACAC,KAAA;MACAC,GAAA,OAAAJ,QAAA;IACA;EACA;EACAK,OAAA;IACA;IACAC,iBAAAC,GAAA;MACA,KAAAP,QAAA,GAAAO,GAAA;MACA,KAAAC,WAAA;IACA;IACA;IACAC,oBAAAF,GAAA;MACA,KAAAR,SAAA,GAAAQ,GAAA;MACA,KAAAC,WAAA;IACA;IAEA;IACAE,YAAAC,GAAA;MACA,MAAAd,IAAA,QAAAe,gBAAA,CAAAD,GAAA;MACA,KAAAb,QAAA,GAAAD,IAAA,CAAAC,QAAA;MACA,KAAAI,SAAA,GAAAL,IAAA,CAAAK,SAAA;IACA;IAEA;IACAM,YAAA;MACA,MAAAK,QAAA,QAAAC,YAAA,MAAAd,QAAA,OAAAD,SAAA;MACA,KAAAgB,KAAA,CAAAC,IAAA,yBAAAH,QAAA,EAAAI,IAAA,CAAAN,GAAA;QACA,KAAAD,WAAA,CAAAC,GAAA;MACA;IACA;IAEA;IACAO,cAAAC,IAAA;MACA,MAAAN,QAAA,QAAAC,YAAA,MAAAd,QAAA,OAAAD,SAAA;MACA,KAAAgB,KAAA,CAAAC,IAAA,uBAAAG,IAAA,CAAAC,OAAA,EAAAP,QAAA,EAAAI,IAAA,CAAAN,GAAA;QACA,KAAAD,WAAA,CAAAC,GAAA;MACA;IACA;IAEA;IACAU,YAAA;MACA,KAAApB,SAAA,QAAAqB,YAAA;MACA,KAAAtB,QAAA,QAAAC,SAAA;IACA;EACA;EACAsB,QAAA;IACA,KAAAF,WAAA;IACA,KAAAb,WAAA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}