{"ast":null,"code":"import { mapGetters, mapState } from \"vuex\";\nimport Logo from \"./Logo\";\nimport AsideMenu from \"./Aside\";\nimport sidebarMenu from \"./Sidebar\";\nexport default {\n  name: \"Aside\",\n  components: {\n    Logo,\n    AsideMenu,\n    sidebarMenu\n  },\n  data() {\n    return {};\n  },\n  methods: {},\n  computed: {\n    ...mapState([\"settings\"]),\n    ...mapGetters([\"isCollapse\"]),\n    //是否显示logo\n    showLogo() {\n      return this.$store.state.settings.sidebarLogo;\n    },\n    //是否显示顶部导航\n    showTopNav() {\n      return this.$store.state.settings.topNav;\n    }\n  }\n};","map":{"version":3,"names":["mapGetters","mapState","Logo","AsideMenu","sidebarMenu","name","components","data","methods","computed","showLogo","$store","state","settings","sidebarLogo","showTopNav","topNav"],"sources":["src/components/Aside/index.vue"],"sourcesContent":["<template>\n  <div :style=\"{ backgroundColor: settings.sideTheme === 'theme-dark' ? `#304156` : `#ffffff` }\" class=\"asideContainer\">\n    <Logo v-if=\"showLogo\" :collapse=\"isCollapse\"/>\n    <!--    <h3>{{ isCollapse ? \"科研\" : \"科研项目管理系统\" }}</h3>-->\n    <AsideMenu v-if=\"!showTopNav\"/>\n    <sidebarMenu v-if=\"showTopNav\"/>\n  </div>\n</template>\n<script>\nimport {mapGetters, mapState} from \"vuex\";\nimport Logo from \"./Logo\";\nimport AsideMenu from \"./Aside\"\nimport sidebarMenu from \"./Sidebar\"\n\nexport default {\n  name: \"Aside\",\n  components: {Logo, AsideMenu, sidebarMenu},\n  data() {\n    return {};\n  },\n  methods: {},\n  computed: {\n    ...mapState([\"settings\"]),\n    ...mapGetters([\"isCollapse\"]),\n    //是否显示logo\n    showLogo() {\n      return this.$store.state.settings.sidebarLogo;\n    },\n    //是否显示顶部导航\n    showTopNav() {\n      return this.$store.state.settings.topNav;\n    },\n  },\n};\n</script>\n\n<style lang=\"less\" scoped>\n.el-menu {\n  min-height: 200vh;\n  height: 300%;\n  border-right: none;\n\n  h3 {\n    color: white;\n    text-align: center;\n    line-height: 48px;\n    font-size: 16px;\n    font-weight: 400;\n    padding: 0 20px;\n  }\n}\n</style>\n"],"mappings":"AASA,SAAAA,UAAA,EAAAC,QAAA;AACA,OAAAC,IAAA;AACA,OAAAC,SAAA;AACA,OAAAC,WAAA;AAEA;EACAC,IAAA;EACAC,UAAA;IAAAJ,IAAA;IAAAC,SAAA;IAAAC;EAAA;EACAG,KAAA;IACA;EACA;EACAC,OAAA;EACAC,QAAA;IACA,GAAAR,QAAA;IACA,GAAAD,UAAA;IACA;IACAU,SAAA;MACA,YAAAC,MAAA,CAAAC,KAAA,CAAAC,QAAA,CAAAC,WAAA;IACA;IACA;IACAC,WAAA;MACA,YAAAJ,MAAA,CAAAC,KAAA,CAAAC,QAAA,CAAAG,MAAA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}