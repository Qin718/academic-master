{"ast":null,"code":"export default {\n  name: \"ProcessProject\",\n  data() {\n    return {\n      //数据参数\n      searchData: {},\n      //搜索数据\n      projectData: {},\n      //查看数据\n      userData: {},\n      //创建者数据\n      process: {},\n      //审核数据\n\n      //集合参数\n      dataList: [],\n      //页面展示的数据集合\n\n      //页号参数\n      pageIndex: 1,\n      pageSize: 5,\n      pageSizes: [],\n      totalPage: 0,\n      begin: 0,\n      end: this.pageSize - 1,\n      //窗口显示参数\n      processWindow: false,\n      lookWindow: false,\n      //其他\n      dataListFrom: \"getDataList\" //当前数据来源于搜索还是全局\n    };\n  },\n  methods: {\n    //改变数组大小\n    sizeChangeHandle(val) {\n      this.pageSize = val;\n      this.SizeOrCurrentChangeAfter();\n    },\n    //改变当前页号\n    CurrentChangeHandle(val) {\n      this.pageIndex = val;\n      this.SizeOrCurrentChangeAfter();\n    },\n    //在更改数组大小或者页号前，判断数据来源\n    SizeOrCurrentChangeAfter() {\n      if (this.dataListFrom === \"getDataList\") this.getDataList();else this.getDataListBySearch();\n    },\n    //审核项目\n    updateProcess() {\n      this.processWindow = false;\n      const data = {\n        processBo: this.process,\n        pageBo: this.$getPageInfo(this.pageSize, this.pageIndex)\n      };\n      this.$http.post(\"/process/updateProcess\", data).then(res => {\n        this.cutDataList(res);\n      });\n    },\n    //分页操作\n    cutDataList(res) {\n      const data = this.$cutPageDataList(res);\n      this.dataList = data.dataList;\n      this.totalPage = data.totalPage;\n    },\n    //查询所有数据\n    getDataList() {\n      this.dataListFrom = \"getDataList\";\n      const pageInfo = this.$getPageInfo(this.pageSize, this.pageIndex);\n      this.$http.post(\"/item/getPageVo/Process\", pageInfo).then(res => {\n        this.cutDataList(res);\n      });\n    },\n    //查询单条数据\n    getDataListBySearch() {\n      this.dataListFrom = \"getDataListBySearch\";\n      const data = {\n        pageBo: this.$getPageInfo(this.pageSize, this.pageIndex),\n        projectBo: this.searchData\n      };\n      this.$http.post(\"/item/getPageVo/Process/search\", data).then(res => {\n        this.cutDataList(res);\n      });\n    },\n    //打开查看页面\n    openLookWindow(item) {\n      //打开项目详细界面\n      this.lookWindow = true;\n      this.projectData = item.project;\n      this.userData = item.user;\n      this.projectData.status = item.status;\n      this.projectData.createTime = item.createTime;\n      this.projectData.updateTime = item.updateTime;\n    },\n    //打开审核页面\n    openProcessWindow(item) {\n      this.process = item.process;\n      //打开界面\n      this.processWindow = true;\n      this.projectData = item.project;\n      this.userData = item.user;\n      this.projectData.status = item.status;\n      this.projectData.createTime = item.createTime;\n      this.projectData.updateTime = item.updateTime;\n    },\n    //初始化页号\n    setPageSize() {\n      this.pageSizes = this.$getPageSize();\n      this.pageSize = this.pageSizes[0];\n    }\n  },\n  mounted() {\n    this.setPageSize();\n    this.getDataList();\n  }\n};","map":{"version":3,"names":["name","data","searchData","projectData","userData","process","dataList","pageIndex","pageSize","pageSizes","totalPage","begin","end","processWindow","lookWindow","dataListFrom","methods","sizeChangeHandle","val","SizeOrCurrentChangeAfter","CurrentChangeHandle","getDataList","getDataListBySearch","updateProcess","processBo","pageBo","$getPageInfo","$http","post","then","res","cutDataList","$cutPageDataList","pageInfo","projectBo","openLookWindow","item","project","user","status","createTime","updateTime","openProcessWindow","setPageSize","$getPageSize","mounted"],"sources":["src/views/project/ProcessProject/index.vue"],"sourcesContent":["<template>\n  <el-card class=\"box-card\">\n    <div>\n      <!-- 搜索框 -->\n      <el-form :model=\"searchData\" ref=\"searchData\" :inline=\"true\" class=\"demo-form-inline\">\n        <el-form-item label=\"项目名称\">\n          <el-input\n            v-model=\"searchData.name\"\n            clearable\n            placeholder=\"项目名称\"\n          ></el-input>\n        </el-form-item>\n        <el-form-item>\n          <el-button @click=\"getDataListBySearch\" icon=\"el-icon-search\" type=\"primary\">\n            查询\n          </el-button>\n        </el-form-item>\n      </el-form>\n      <!-- 数据表单 -->\n      <el-table ref=\"multipleTable\" :data=\"dataList\" border>\n        <el-table-column type=\"selection\" width=\"55\"></el-table-column>\n        <el-table-column label=\"项目编号\" prop=\"projectId\" width=\"80\">\n        </el-table-column>\n        <el-table-column label=\"项目名称\" prop=\"project.name\" width=\"150\">\n        </el-table-column>\n        <el-table-column label=\"项目审核状态\" prop=\"status\" width=\"120\">\n        </el-table-column>\n        <el-table-column label=\"项目创建人\" prop=\"user.username\" width=\"150\">\n        </el-table-column>\n        <el-table-column label=\"创建时间\" prop=\"createTime\" width=\"180\">\n        </el-table-column>\n        <el-table-column\n          label=\"最近一次的修改时间\"\n          prop=\"updateTime\"\n          width=\"180\"\n        >\n        </el-table-column>\n        <el-table-column label=\"操作\">\n          <template v-slot=\"scope\">\n            <el-button @click=\"openLookWindow(scope.row)\" size=\"mini\" type=\"primary\">\n              查看\n            </el-button>\n            <el-button @click=\"openProcessWindow(scope.row)\" size=\"mini\" type=\"success\">\n              审核\n            </el-button>\n          </template>\n        </el-table-column>\n      </el-table>\n      <!-- 查看打开的界面 -->\n      <el-dialog\n        :model=\"projectData\"\n        :visible.sync=\"lookWindow\"\n        title=\"项目详情\"\n        width=\"50%\"\n      >\n        <el-descriptions title=\"项目信息\">\n          <el-descriptions-item label=\"项目编号\">\n            {{ this.projectData.id }}\n          </el-descriptions-item>\n          <el-descriptions-item label=\"项目名称\">\n            {{ this.projectData.name }}\n          </el-descriptions-item>\n          <el-descriptions-item label=\"项目类型\">\n            {{ this.projectData.type }}\n          </el-descriptions-item>\n          <el-descriptions-item label=\"项目状态\">\n            {{ this.projectData.status }}\n          </el-descriptions-item>\n\n          <el-descriptions-item label=\"创建人\">\n            <el-tag size=\"small\">\n              {{ this.userData.name }}\n              </el-tag>\n          </el-descriptions-item>\n          <el-descriptions-item label=\"项目说明\">\n              {{this.projectData['remark']}}\n          </el-descriptions-item>\n        </el-descriptions>\n        <el-descriptions column:2>\n          <el-descriptions-item label=\"申请资金\">\n            {{this.projectData['money']}}\n          </el-descriptions-item>\n          <el-descriptions-item label=\"创建时间\">\n            {{this.projectData.createTime}}\n          </el-descriptions-item>\n        </el-descriptions>\n        <el-descriptions>\n          <el-descriptions-item label=\"最近一次修改时间\" prop=\"updateTime\">\n            {{this.projectData.updateTime}}\n          </el-descriptions-item>\n        </el-descriptions>\n        <el-divider></el-divider>\n        <el-descriptions title=\"项目创建者信息\">\n          <el-descriptions-item label=\"账号\">\n            {{ this.userData.username }}\n          </el-descriptions-item>\n          <el-descriptions-item label=\"姓名\">\n            <el-tag size=\"small\">\n             {{ this.userData.name }}\n            </el-tag>\n          </el-descriptions-item>\n          <el-descriptions-item label=\"邮箱\">\n          {{this.userData.email}}\n          </el-descriptions-item>\n          <el-descriptions-item label=\"手机号码\">\n            {{this.userData.mobile}}\n          </el-descriptions-item>\n          <el-descriptions-item label=\"账号状态\">\n              {{this.userData.status === 0 ? \"激活\" : \"禁用\"}}\n          </el-descriptions-item>\n        </el-descriptions>\n      </el-dialog>\n      <!-- 审核按钮打开的页面 -->\n      <el-dialog\n        :model=\"projectData\"\n        :visible.sync=\"processWindow\"\n        title=\"审核项目\"\n        width=\"50%\"\n      >\n        <el-descriptions title=\"项目信息\">\n          <el-descriptions-item label=\"项目编号\">\n            {{ this.projectData.id }}\n          </el-descriptions-item>\n          <el-descriptions-item label=\"项目名称\">\n            {{ this.projectData.name }}\n          </el-descriptions-item>\n          <el-descriptions-item label=\"项目类型\">\n            {{ this.projectData.type }}\n          </el-descriptions-item>\n          <el-descriptions-item label=\"项目状态\">\n              {{this.projectData.status}}\n          </el-descriptions-item>\n\n          <el-descriptions-item label=\"创建人\">\n            <el-tag size=\"small\">\n             {{ this.userData.name }}\n            </el-tag>\n          </el-descriptions-item>\n          <el-descriptions-item label=\"项目说明\">\n            {{this.projectData['remark']}}\n          </el-descriptions-item>\n        </el-descriptions>\n        <el-descriptions column:2>\n          <el-descriptions-item label=\"创建时间\">\n              {{this.projectData.createTime}}\n          </el-descriptions-item>\n          <el-descriptions-item label=\"申请资金\">\n              {{this.projectData['money']}}\n          </el-descriptions-item>\n        </el-descriptions>\n        <el-descriptions>\n          <el-descriptions-item label=\"最近一次修改时间\" prop=\"updateTime\">\n            {{this.projectData.updateTime}}\n          </el-descriptions-item>\n        </el-descriptions>\n        <el-divider></el-divider>\n        <!-- 审核结果和审核意见 -->\n        <el-form :model=\"process\">\n          <el-form-item label=\"审核结果\" label-width=\"120px\">\n            <el-select v-model=\"process.process\" :placeholder=\"'未 审 核'\">\n              <el-option label=\"审 核 不 通 过\" value=\"审核不通过\"></el-option>\n              <el-option label=\"审  核  通  过\" value=\"审核通过\"></el-option>\n            </el-select>\n          </el-form-item>\n          <el-form-item label=\"审核意见\" label-width=\"120px\">\n            <el-input\n              v-model=\"process['remark']\"\n              placeholder=\"审核意见\"\n              style=\"width: 80%\"\n              type=\"textarea\"\n            ></el-input>\n          </el-form-item>\n        </el-form>\n\n        <div slot=\"footer\" class=\"dialog-footer\">\n          <el-button @click=\"processWindow = false\">取 消</el-button>\n          <el-button type=\"primary\" @click=\"updateProcess()\">提 交</el-button>\n        </div>\n      </el-dialog>\n      <!-- 页号 -->\n      <el-pagination\n        :current-page=\"pageIndex\"\n        :page-size=\"pageSize\"\n        :page-sizes=\"pageSizes\"\n        :total=\"totalPage\"\n        layout=\"total ,sizes,prev,pager,next,jumper\"\n        style=\"margin-top: 30px\"\n        @size-change=\"sizeChangeHandle\"\n        @current-change=\"CurrentChangeHandle\"\n      >\n      </el-pagination>\n    </div>\n  </el-card>\n</template>\n<script>\nexport default {\n  name: \"ProcessProject\",\n  data() {\n    return {\n      //数据参数\n      searchData: {},//搜索数据\n      projectData: {},//查看数据\n      userData: {},//创建者数据\n      process: {},//审核数据\n\n      //集合参数\n      dataList: [], //页面展示的数据集合\n\n      //页号参数\n      pageIndex: 1,\n      pageSize: 5,\n      pageSizes: [],\n      totalPage: 0,\n      begin: 0,\n      end: this.pageSize - 1,\n\n      //窗口显示参数\n      processWindow: false,\n      lookWindow: false,\n\n      //其他\n      dataListFrom: \"getDataList\",//当前数据来源于搜索还是全局\n    };\n  },\n  methods: {\n    //改变数组大小\n    sizeChangeHandle(val) {\n      this.pageSize = val;\n      this.SizeOrCurrentChangeAfter();\n    },\n    //改变当前页号\n    CurrentChangeHandle(val) {\n      this.pageIndex = val;\n      this.SizeOrCurrentChangeAfter();\n    },\n    //在更改数组大小或者页号前，判断数据来源\n    SizeOrCurrentChangeAfter() {\n      if (this.dataListFrom === \"getDataList\")\n        this.getDataList();\n      else this.getDataListBySearch();\n    },\n\n    //审核项目\n    updateProcess() {\n      this.processWindow = false;\n      const data = {\n        processBo: this.process,\n        pageBo: this.$getPageInfo(this.pageSize, this.pageIndex)\n      }\n      this.$http.post(\"/process/updateProcess\", data).then((res) => {\n        this.cutDataList(res);\n      });\n    },\n\n    //分页操作\n    cutDataList(res) {\n      const data = this.$cutPageDataList(res)\n      this.dataList = data.dataList\n      this.totalPage = data.totalPage\n    },\n\n    //查询所有数据\n    getDataList() {\n      this.dataListFrom = \"getDataList\";\n      const pageInfo = this.$getPageInfo(this.pageSize, this.pageIndex)\n      this.$http.post(\"/item/getPageVo/Process\", pageInfo).then((res) => {\n        this.cutDataList(res);\n      });\n    },\n    //查询单条数据\n    getDataListBySearch() {\n      this.dataListFrom = \"getDataListBySearch\";\n      const data = {\n        pageBo: this.$getPageInfo(this.pageSize, this.pageIndex),\n        projectBo: this.searchData\n      }\n      this.$http.post(\"/item/getPageVo/Process/search\", data).then((res) => {\n        this.cutDataList(res);\n      });\n    },\n\n    //打开查看页面\n    openLookWindow(item) {\n      //打开项目详细界面\n      this.lookWindow = true;\n      this.projectData = item.project;\n      this.userData = item.user;\n      this.projectData.status = item.status\n      this.projectData.createTime = item.createTime\n      this.projectData.updateTime = item.updateTime\n    },\n    //打开审核页面\n    openProcessWindow(item) {\n      this.process = item.process;\n      //打开界面\n      this.processWindow = true;\n      this.projectData = item.project;\n      this.userData = item.user;\n      this.projectData.status = item.status\n      this.projectData.createTime = item.createTime\n      this.projectData.updateTime = item.updateTime\n    },\n\n    //初始化页号\n    setPageSize() {\n      this.pageSizes = this.$getPageSize()\n      this.pageSize = this.pageSizes[0]\n    }\n  },\n  mounted() {\n\t  this.setPageSize();\n    this.getDataList();\n  },\n};\n</script>\n"],"mappings":"AAmMA;EACAA,IAAA;EACAC,KAAA;IACA;MACA;MACAC,UAAA;MAAA;MACAC,WAAA;MAAA;MACAC,QAAA;MAAA;MACAC,OAAA;MAAA;;MAEA;MACAC,QAAA;MAAA;;MAEA;MACAC,SAAA;MACAC,QAAA;MACAC,SAAA;MACAC,SAAA;MACAC,KAAA;MACAC,GAAA,OAAAJ,QAAA;MAEA;MACAK,aAAA;MACAC,UAAA;MAEA;MACAC,YAAA;IACA;EACA;EACAC,OAAA;IACA;IACAC,iBAAAC,GAAA;MACA,KAAAV,QAAA,GAAAU,GAAA;MACA,KAAAC,wBAAA;IACA;IACA;IACAC,oBAAAF,GAAA;MACA,KAAAX,SAAA,GAAAW,GAAA;MACA,KAAAC,wBAAA;IACA;IACA;IACAA,yBAAA;MACA,SAAAJ,YAAA,oBACA,KAAAM,WAAA,QACA,KAAAC,mBAAA;IACA;IAEA;IACAC,cAAA;MACA,KAAAV,aAAA;MACA,MAAAZ,IAAA;QACAuB,SAAA,OAAAnB,OAAA;QACAoB,MAAA,OAAAC,YAAA,MAAAlB,QAAA,OAAAD,SAAA;MACA;MACA,KAAAoB,KAAA,CAAAC,IAAA,2BAAA3B,IAAA,EAAA4B,IAAA,CAAAC,GAAA;QACA,KAAAC,WAAA,CAAAD,GAAA;MACA;IACA;IAEA;IACAC,YAAAD,GAAA;MACA,MAAA7B,IAAA,QAAA+B,gBAAA,CAAAF,GAAA;MACA,KAAAxB,QAAA,GAAAL,IAAA,CAAAK,QAAA;MACA,KAAAI,SAAA,GAAAT,IAAA,CAAAS,SAAA;IACA;IAEA;IACAW,YAAA;MACA,KAAAN,YAAA;MACA,MAAAkB,QAAA,QAAAP,YAAA,MAAAlB,QAAA,OAAAD,SAAA;MACA,KAAAoB,KAAA,CAAAC,IAAA,4BAAAK,QAAA,EAAAJ,IAAA,CAAAC,GAAA;QACA,KAAAC,WAAA,CAAAD,GAAA;MACA;IACA;IACA;IACAR,oBAAA;MACA,KAAAP,YAAA;MACA,MAAAd,IAAA;QACAwB,MAAA,OAAAC,YAAA,MAAAlB,QAAA,OAAAD,SAAA;QACA2B,SAAA,OAAAhC;MACA;MACA,KAAAyB,KAAA,CAAAC,IAAA,mCAAA3B,IAAA,EAAA4B,IAAA,CAAAC,GAAA;QACA,KAAAC,WAAA,CAAAD,GAAA;MACA;IACA;IAEA;IACAK,eAAAC,IAAA;MACA;MACA,KAAAtB,UAAA;MACA,KAAAX,WAAA,GAAAiC,IAAA,CAAAC,OAAA;MACA,KAAAjC,QAAA,GAAAgC,IAAA,CAAAE,IAAA;MACA,KAAAnC,WAAA,CAAAoC,MAAA,GAAAH,IAAA,CAAAG,MAAA;MACA,KAAApC,WAAA,CAAAqC,UAAA,GAAAJ,IAAA,CAAAI,UAAA;MACA,KAAArC,WAAA,CAAAsC,UAAA,GAAAL,IAAA,CAAAK,UAAA;IACA;IACA;IACAC,kBAAAN,IAAA;MACA,KAAA/B,OAAA,GAAA+B,IAAA,CAAA/B,OAAA;MACA;MACA,KAAAQ,aAAA;MACA,KAAAV,WAAA,GAAAiC,IAAA,CAAAC,OAAA;MACA,KAAAjC,QAAA,GAAAgC,IAAA,CAAAE,IAAA;MACA,KAAAnC,WAAA,CAAAoC,MAAA,GAAAH,IAAA,CAAAG,MAAA;MACA,KAAApC,WAAA,CAAAqC,UAAA,GAAAJ,IAAA,CAAAI,UAAA;MACA,KAAArC,WAAA,CAAAsC,UAAA,GAAAL,IAAA,CAAAK,UAAA;IACA;IAEA;IACAE,YAAA;MACA,KAAAlC,SAAA,QAAAmC,YAAA;MACA,KAAApC,Q