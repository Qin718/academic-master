<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.system.mapper.LoginMapper">
    <insert id="insertLogin" keyColumn="id" keyProperty="id" useGeneratedKeys="true">
        insert into sys_login (account, username, time, ip, mobile, inner_ip)
        VALUES (#{login.account}, #{login.username}, #{login.time}, #{login.ip}, #{login.mobile}, #{login.innerIp})
    </insert>
    <select id="getList" resultType="com.example.system.domain.vo.LoginVo">
        select *
        from sys_login
    </select>
</mapper>
